# Stage 1 — Free Testing
# Provider: Render Free (API), Vercel Hobby (Web), Neon Free (DB), Upstash Free (Redis), R2 Free
# Copy to .env and fill in real values before deploying.

# --- Database (Neon Free) ---
DATABASE_URL="postgresql://neondb_owner:<password>@<host>.neon.tech/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://neondb_owner:<password>@<host>-pooler.neon.tech/neondb?sslmode=require"
DATABASE_URL_DIRECT="postgresql://neondb_owner:<password>@<host>.neon.tech/neondb?sslmode=require"
DB_POOL_APP_NAME="pim1-stage1-api"

# --- API base URL ---
PIM_API_BASE_URL="https://<your-render-service>.onrender.com/api/v1"

# --- Auth & JWT ---
JWT_SECRET="replace-with-long-random-secret-at-least-32-chars"
JWT_EXPIRY="4h"
JWT_BLOCKLIST_KEY_PREFIX="jti:"

# --- Redis (Upstash Free) ---
REDIS_URL="rediss://default:<token>@<host>.upstash.io:6379"
CACHE_REDIS_DISABLED="false"
JWT_BLOCKLIST_REDIS_DISABLED="false"
PIM_AUTH_REDIS_KEY_PREFIX="pim1:auth:"
PIM_AUTH_REDIS_DISABLED="false"

# --- Credential encryption ---
CREDENTIAL_ENCRYPTION_KEY_V1="replace-with-base64-key"
CREDENTIAL_ENCRYPTION_KEY_V2=""
CREDENTIAL_ENCRYPTION_KEY_CURRENT_VERSION="1"

# --- Object Storage ---
# Use MEDIA_LOCAL_FALLBACK="true" for quick setup without R2 (mount volume at /app/storage/media).
# Set R2_* and remove MEDIA_LOCAL_FALLBACK once a bucket is provisioned.
MEDIA_LOCAL_FALLBACK="true"
R2_ACCOUNT_ID="replace-me"
R2_ACCESS_KEY_ID="replace-me"
R2_SECRET_ACCESS_KEY="replace-me"
R2_BUCKET_NAME="pim1-stage1-media"
R2_PUBLIC_URL="https://pub-<hash>.r2.dev"

# --- App config ---
APP_ENV="staging"
PORT="4000"

# --- Feature flags (Stage 1: workers and heavy features off) ---
FEATURE_REAL_SPAPI_VALIDATION="false"
FEATURE_ONDC_ENABLED="false"
FEATURE_PUBLIC_SIGNUP_ENABLED="false"   # disable — internal testing only
NEXT_PUBLIC_FEATURE_PUBLIC_SIGNUP_ENABLED="false"
NEXT_PUBLIC_FEATURE_ONDC_ENABLED="false"
# Worker is disabled at Stage 1 — Render Free sleeps and cannot run a persistent BullMQ process
QUEUE_WORKER_ENABLED="false"

# --- Commercial / trial ---
PIM_COMMERCIAL_CONTACT_URL=""
PIM_COMMERCIAL_CONTACT_EMAIL=""
PIM_COMMERCIAL_OPS_TOKEN=""
PIM_COMMERCIAL_TRIAL_DAYS="14"

# --- Marketplace connectors (configure when testing connector flows) ---
AMAZON_CLIENT_ID=""
AMAZON_CLIENT_SECRET=""
FLIPKART_CLIENT_ID=""
FLIPKART_CLIENT_SECRET=""
MEESHO_MERCHANT_ID=""
MEESHO_SECRET_KEY=""

# --- Multi-tenant defaults ---
PIM_DEFAULT_TENANT_KEY="default"
PIM_DEFAULT_ROLE="viewer"
PIM_ALLOW_LEGACY_HEADERS="false"
CORS_ORIGIN="https://<your-vercel-app>.vercel.app"

# --- Data retention ---
DATA_RETENTION_DAYS_PERSONAL="365"
DPDP_CONSENT_VERSION="1"
