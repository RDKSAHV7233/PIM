# Stage 2 — Investor Demo
# Provider: Render/Railway paid (API), Vercel Pro (Web), Neon Launch (DB), Upstash pay-as-you-go (Redis), R2
# Copy to .env and fill in real values before deploying.

# --- Database (Neon Launch — $19/month, 10 GB, autoscaling) ---
DATABASE_URL="postgresql://neondb_owner:<password>@<host>.neon.tech/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://neondb_owner:<password>@<host>-pooler.neon.tech/neondb?sslmode=require"
DATABASE_URL_DIRECT="postgresql://neondb_owner:<password>@<host>.neon.tech/neondb?sslmode=require"
DB_POOL_APP_NAME="pim1-stage2-api"

# --- API base URL (always-on paid service, no sleep) ---
PIM_API_BASE_URL="https://<your-api>.railway.app/api/v1"

# --- Auth & JWT ---
JWT_SECRET="replace-with-long-random-secret-at-least-32-chars"
JWT_EXPIRY="4h"
JWT_BLOCKLIST_KEY_PREFIX="jti:"

# --- Redis (Upstash pay-as-you-go, ~$5-10/month) ---
REDIS_URL="rediss://default:<token>@<host>.upstash.io:6379"
CACHE_REDIS_DISABLED="false"
JWT_BLOCKLIST_REDIS_DISABLED="false"
PIM_AUTH_REDIS_KEY_PREFIX="pim1:auth:"
PIM_AUTH_REDIS_DISABLED="false"

# --- Credential encryption ---
CREDENTIAL_ENCRYPTION_KEY_V1="replace-with-base64-key"
CREDENTIAL_ENCRYPTION_KEY_V2=""
CREDENTIAL_ENCRYPTION_KEY_CURRENT_VERSION="1"

# --- Object Storage (Cloudflare R2) ---
# Remove MEDIA_LOCAL_FALLBACK and configure R2_* for stage2 (investor demo needs real media).
# Volume mount at /app/storage/media is still recommended as a backup even with R2.
MEDIA_LOCAL_FALLBACK="false"
R2_ACCOUNT_ID="replace-me"
R2_ACCESS_KEY_ID="replace-me"
R2_SECRET_ACCESS_KEY="replace-me"
R2_BUCKET_NAME="pim1-stage2-media"
R2_PUBLIC_URL="https://cdn.<your-domain>.com"

# --- App config ---
APP_ENV="staging"
PORT="4000"

# --- Feature flags (Stage 2: worker enabled, demo features on) ---
FEATURE_REAL_SPAPI_VALIDATION="false"
FEATURE_ONDC_ENABLED="false"
FEATURE_PUBLIC_SIGNUP_ENABLED="true"    # enable for demo/investor flows
NEXT_PUBLIC_FEATURE_PUBLIC_SIGNUP_ENABLED="true"
NEXT_PUBLIC_FEATURE_ONDC_ENABLED="false"
# Worker enabled — paid service does not sleep
QUEUE_WORKER_ENABLED="true"

# --- Commercial / trial ---
PIM_COMMERCIAL_CONTACT_URL="https://<your-site>.com/contact"
PIM_COMMERCIAL_CONTACT_EMAIL="hello@<your-domain>.com"
PIM_COMMERCIAL_OPS_TOKEN="replace-with-ops-token"
PIM_COMMERCIAL_TRIAL_DAYS="14"

# --- Marketplace connectors ---
AMAZON_CLIENT_ID="replace-me"
AMAZON_CLIENT_SECRET="replace-me"
FLIPKART_CLIENT_ID="replace-me"
FLIPKART_CLIENT_SECRET="replace-me"
MEESHO_MERCHANT_ID=""
MEESHO_SECRET_KEY=""

# --- Multi-tenant defaults ---
PIM_DEFAULT_TENANT_KEY="default"
PIM_DEFAULT_ROLE="viewer"
PIM_ALLOW_LEGACY_HEADERS="false"
CORS_ORIGIN="https://<your-domain>.com"

# --- Data retention ---
DATA_RETENTION_DAYS_PERSONAL="365"
DPDP_CONSENT_VERSION="1"
