# Stage 3 — Pilot Ready
# Provider: Railway 2 vCPU (API + separate Worker), Vercel Pro (Web),
#           Neon Pro / Railway managed Postgres (50 GB, PITR), Upstash Pro 1 GB (Redis), R2
# Copy values into Railway environment variables (do not commit secrets).

# --- Database (Neon Pro or Railway managed Postgres — 50 GB, daily PITR) ---
DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"
DATABASE_URL_POOLED="postgresql://<user>:<password>@<host>-pooler/<db>?sslmode=require"
DATABASE_URL_DIRECT="postgresql://<user>:<password>@<host>/<db>?sslmode=require"
DB_POOL_APP_NAME="pim1-stage3-api"

# --- API base URL ---
PIM_API_BASE_URL="https://api.<your-domain>.com/api/v1"

# --- Auth & JWT ---
JWT_SECRET="replace-with-long-random-secret-at-least-32-chars"
JWT_EXPIRY="4h"
JWT_BLOCKLIST_KEY_PREFIX="jti:"

# --- Redis (Upstash Pro — 1 GB, persistence, no eviction) ---
REDIS_URL="rediss://default:<token>@<host>.upstash.io:6379"
CACHE_REDIS_DISABLED="false"
JWT_BLOCKLIST_REDIS_DISABLED="false"
PIM_AUTH_REDIS_KEY_PREFIX="pim1:auth:"
PIM_AUTH_REDIS_DISABLED="false"

# --- Credential encryption ---
CREDENTIAL_ENCRYPTION_KEY_V1="replace-with-base64-key"
CREDENTIAL_ENCRYPTION_KEY_V2=""
CREDENTIAL_ENCRYPTION_KEY_CURRENT_VERSION="1"

# --- Object Storage (Cloudflare R2 — product images, import/export files, backups) ---
R2_ACCOUNT_ID="replace-me"
R2_ACCESS_KEY_ID="replace-me"
R2_SECRET_ACCESS_KEY="replace-me"
R2_BUCKET_NAME="pim1-pilot-media"
R2_PUBLIC_URL="https://cdn.<your-domain>.com"

# --- App config ---
APP_ENV="production"
PORT="4000"

# --- Feature flags (Stage 3: all pilot features on) ---
FEATURE_REAL_SPAPI_VALIDATION="true"    # real Amazon SP-API validation
FEATURE_ONDC_ENABLED="false"            # enable when ONDC pilot is ready
FEATURE_PUBLIC_SIGNUP_ENABLED="true"
NEXT_PUBLIC_FEATURE_PUBLIC_SIGNUP_ENABLED="true"
NEXT_PUBLIC_FEATURE_ONDC_ENABLED="false"
# API service: worker off (separate Railway service handles BullMQ)
QUEUE_WORKER_ENABLED="false"
# Worker service (set to true on the dedicated worker Railway service):
# QUEUE_WORKER_ENABLED="true"

# --- Commercial / trial ---
PIM_COMMERCIAL_CONTACT_URL="https://vexapim.com/contact"
PIM_COMMERCIAL_CONTACT_EMAIL="billing@vexapim.com"
PIM_COMMERCIAL_OPS_TOKEN="replace-with-ops-token"
PIM_COMMERCIAL_TRIAL_DAYS="14"
PIM_EMAIL_LOGO_URL="https://cdn.vexapim.com/brand/vexa-pim-logo.png"
PIM_EMAIL_BANNER_URL=""
PIM_EMAIL_SUPPORT_URL="https://vexapim.com/support"
PIM_EMAIL_SUPPORT_EMAIL="support@vexapim.com"
PIM_EMAIL_ONBOARDING_FROM="onboarding@vexapim.com"
PIM_EMAIL_NOTIFICATIONS_FROM="notifications@vexapim.com"
PIM_EMAIL_ADMIN_EMAIL="admin@vexapim.com"
PIM_EMAIL_TEAM_EMAIL="team@vexapim.com"

# --- Marketplace connectors ---
AMAZON_CLIENT_ID="replace-me"
AMAZON_CLIENT_SECRET="replace-me"
FLIPKART_CLIENT_ID="replace-me"
FLIPKART_CLIENT_SECRET="replace-me"
MEESHO_MERCHANT_ID="replace-me"
MEESHO_SECRET_KEY="replace-me"

# --- Multi-tenant defaults ---
PIM_DEFAULT_TENANT_KEY="default"
PIM_DEFAULT_ROLE="viewer"
PIM_ALLOW_LEGACY_HEADERS="false"
CORS_ORIGIN="https://<your-domain>.com"

# --- Data retention & DPDP compliance ---
DATA_RETENTION_DAYS_PERSONAL="365"
DPDP_CONSENT_VERSION="1"
