DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pim1?schema=public"
DATABASE_URL_POOLED="postgresql://postgres:postgres@localhost:5432/pim1?schema=public"
DATABASE_URL_DIRECT="postgresql://postgres:postgres@localhost:5432/pim1?schema=public"
DB_POOL_APP_NAME="vexa-pim-api"
DB_POOL_CONNECTION_LIMIT="5"
PIM_API_BASE_URL="http://localhost:4000/api/v1"
JWT_SECRET="replace-with-long-random-secret-at-least-32-chars"
JWT_EXPIRY="4h"
PIM_JWT_SECRET="replace-with-long-random-secret-at-least-32-chars"
PIM_JWT_EXPIRY="4h"
PIM_DEFAULT_TENANT_KEY="default"
PIM_DEFAULT_ROLE="viewer"
PIM_ALLOW_LEGACY_HEADERS="false"
CORS_ORIGIN="http://localhost:3000"
REDIS_URL="redis://localhost:6379"
QUEUE_BACKEND="memory"
QUEUE_WORKER_ENABLED="true"
CACHE_REDIS_DISABLED="false"
JWT_BLOCKLIST_KEY_PREFIX="jti:"
JWT_BLOCKLIST_REDIS_DISABLED="false"
PIM_AUTH_REDIS_KEY_PREFIX="pim1:auth:"
PIM_AUTH_REDIS_DISABLED="false"
APP_ENV="development"
AUTH_MODE="local" # local | db (staging/production must use db)
PORT="4000"
PIM_AUTH_PASSWORD="vexa-pim-demo-password"
# IMPORTANT: Do NOT start the API with 'source .env' in bash.
# Bash silently discards values containing '{' (JSON objects), causing
# PIM_AUTH_IDENTITIES_JSON to arrive as "" in the process — all users then
# default to role=viewer and admin login breaks. The server will throw
# [AUTH BOOT FAILURE] at startup if this misconfiguration is detected.
# Correct startup: 'npm run dev:api' or 'npm run start --workspace @pim1/api'
# (both use dotenv-cli which handles JSON values correctly).
PIM_AUTH_IDENTITIES_JSON="" # local mode only. leave empty when AUTH_MODE=db.
# Dev-only: bypass quota checks for load/stress testing.
# Set to ENTERPRISE to skip PLAN_LIMIT_EXCEEDED errors during local stress runs.
# Only active when APP_ENV=development — ignored in staging and production.
# Remove or leave empty before deploying.
PIM_PLAN_TIER_OVERRIDE="" # e.g. ENTERPRISE for local stress testing
PIM_PLAN_GUARD_FORCE_ENFORCE="" # Set to "true" to enable plan-limit-enforcement integration tests (plan-limit-enforcement.spec.js:21)
PIM_COMMERCIAL_CONTACT_URL=""
PIM_COMMERCIAL_CONTACT_EMAIL=""
PIM_COMMERCIAL_OPS_TOKEN=""
PIM_COMMERCIAL_TRIAL_DAYS="14"
PIM_EMAIL_LOGO_URL="" # HTTPS URL to Vexa logo image (recommended for staging/production)
PIM_EMAIL_BANNER_URL="" # Optional HTTPS URL to email banner image
PIM_EMAIL_SUPPORT_URL="" # Support page URL shown in email footers
PIM_EMAIL_SUPPORT_EMAIL="" # Support email shown in email footers

CREDENTIAL_ENCRYPTION_KEY_V1="replace-with-base64-key"
CREDENTIAL_ENCRYPTION_KEY_V2=""
CREDENTIAL_ENCRYPTION_KEY_CURRENT_VERSION="1"

R2_ACCOUNT_ID="replace-me"
R2_ACCESS_KEY_ID="replace-me"
R2_SECRET_ACCESS_KEY="replace-me"
R2_BUCKET_NAME="vexa-pim-media-dev"
R2_PUBLIC_URL="https://cdn.example.com"
# Signed, tenant-bound, expiring tokens for the PUBLIC media file route (GET /media/assets/:id/file?t=...). At least 32 characters.
# Until it is set the route serves unsigned and resolves only the default tenant under row level security, so setting it is a
# prerequisite of the database role cutover. MEDIA_URL_SIGNING_KEY_PREVIOUS is accepted for verification only, during a key rotation.
MEDIA_URL_SIGNING_KEY=""
MEDIA_URL_SIGNING_KEY_PREVIOUS=""
MEDIA_URL_TTL_SECONDS="604800" # token lifetime, default 7 days, clamped to 60s..30 days
ACCOUNT_EXPORT_STORAGE_MODE="auto" # auto | filesystem | object_storage
ACCOUNT_EXPORT_STORAGE_DIR="" # set to a writable persistent volume path when ACCOUNT_EXPORT_STORAGE_MODE=filesystem
AWS_REGION="ap-south-1"
AWS_S3_MEDIA_BUCKET=""
AWS_CLOUDFRONT_DISTRIBUTION_ID=""
AWS_CLOUDFRONT_DOMAIN=""

FEATURE_REAL_SPAPI_VALIDATION="false"
FEATURE_ONDC_ENABLED="false"
FEATURE_PUBLIC_SIGNUP_ENABLED="false" # When true, AUTH_MODE must also be "db" — signup users are DB records, invisible to local auth (PIM_AUTH_IDENTITIES_JSON)
NEXT_PUBLIC_FEATURE_PUBLIC_SIGNUP_ENABLED="false"
NEXT_PUBLIC_FEATURE_ONDC_ENABLED="false"
VNEXT_MUTATION_ENABLED="false"
# Do not set true without Epic 2 sign-off. SHA must match the exact release named in the sign-off.
VNEXT_MUTATION_ALLOWLIST_JSON="" # {"tenantKey":"...","connectorSlug":"shopify","installationId":"...","productId":"..."}
VNEXT_MUTATION_APPROVED_RELEASE_SHA="" # exact deploy commit; compared to RAILWAY_GIT_COMMIT_SHA at runtime
VNEXT_MUTATION_ALLOWED_FIELD_CLASS="" # currently only "image"; required with VNEXT_MUTATION_ENABLED=true
VNEXT_MUTATION_APPROVED_PAYLOAD_SHA256="" # exact SHA-256 of the outbound controlledInput authorized for one write
CONNECTOR_STUB_SLUGS="" # comma-separated connector slugs to hide from seller-facing surfaces, e.g. flipkart
NEXT_PUBLIC_CONNECTOR_STUB_SLUGS="" # mirror CONNECTOR_STUB_SLUGS for web readiness/channel surfaces
PIM_AMAZON_VALIDATION_ENDPOINT=""
PIM_AMAZON_VALIDATION_TOKEN=""
AMAZON_CLIENT_ID=""
AMAZON_CLIENT_SECRET=""
FLIPKART_CLIENT_ID=""
FLIPKART_CLIENT_SECRET=""
MEESHO_MERCHANT_ID=""
MEESHO_SECRET_KEY=""

# ── Playwright / Demo / Staging email outbox ─────────────────────────
# Required for signup/commercial Playwright tests. Set to a writable directory path.
# Wrapper scripts (scripts/run-playwright-*.cjs) create a temp dir automatically.
# For persistent staging demo: set to a stable path like /tmp/vexa-pim-signup-outbox
# AUTH_EMAIL_PROVIDER must be "file" when this is used.
PLAYWRIGHT_SIGNUP_OUTBOX_DIR="" # leave empty in production; set for demo/staging test runs
AUTH_EMAIL_PROVIDER="local" # local | resend | file (file = writes emails to PLAYWRIGHT_SIGNUP_OUTBOX_DIR)
AUTH_EMAIL_OUTBOX_DIR="" # mirror of PLAYWRIGHT_SIGNUP_OUTBOX_DIR; set both together
RESEND_WEBHOOK_SECRET="" # Svix signing secret (whsec_<base64>) for POST /api/v1/webhooks/resend; empty = receiver disabled (503)
