# Playwright E2E — local configuration
#
# Web: Playwright builds and serves a production bundle on port 3001 (stable,
#      no webpack lazy-compilation races).
# API: Playwright builds and starts a dedicated API on port 4001 with its own
#      playwright_e2e schema, isolated from the dev database.
#
# Run with:
#   npx dotenv-cli -e .env.playwright -- npx playwright test
# or:
#   npm run test:e2e

PLAYWRIGHT_BASE_URL=http://localhost:3001
PLAYWRIGHT_API_URL=http://localhost:4001/api/v1
PLAYWRIGHT_WORKSPACE=default
PLAYWRIGHT_PASSWORD=vexa-pim-demo-password

# Local test user IDs — must match PLAYWRIGHT_AUTH_IDENTITIES_JSON below
PLAYWRIGHT_ADMIN_USER=admin@pim1.local
PLAYWRIGHT_EDITOR_USER=editor@test.com
PLAYWRIGHT_REVIEWER_USER=reviewer@test.com
PLAYWRIGHT_CHANNEL_MANAGER_USER=channel_manager@test.com
PLAYWRIGHT_VIEWER_USER=viewer@test.com

# Identity directory for the Playwright API server (overrides start-playwright-api.cjs default)
PLAYWRIGHT_AUTH_IDENTITIES_JSON={"admin@pim1.local":{"tenantId":"default","role":"admin"},"editor@test.com":{"tenantId":"default","role":"editor"},"reviewer@test.com":{"tenantId":"default","role":"reviewer"},"channel_manager@test.com":{"tenantId":"default","role":"channel_manager"},"viewer@test.com":{"tenantId":"default","role":"viewer"}}

# Phase 9 (public signup) specs — directory where the API writes verification
# email outbox files. Create the dir first: mkdir -p .runlogs/signup-outbox
PLAYWRIGHT_SIGNUP_OUTBOX_DIR=.runlogs/signup-outbox
