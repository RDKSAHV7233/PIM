# ── App ──────────────────────────────────────────────
NODE_ENV=production
APP_ENV=staging
PORT=4000

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pim1_staging?schema=public
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST:5432/pim1_staging?schema=public
DATABASE_APP_URL=postgresql://USER:PASSWORD@HOST:5432/pim1_staging?schema=public

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=HOST
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ── JWT / Auth ────────────────────────────────────────
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
AUTH_MODE=db

# ── CORS ──────────────────────────────────────────────
CORS_ORIGINS=https://your-web-service.up.railway.app

# ── Web (Next.js) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-api-service.up.railway.app

# ── Marketplace Credentials ───────────────────────────
AMAZON_CLIENT_ID=CHANGE_ME
AMAZON_CLIENT_SECRET=CHANGE_ME
FLIPKART_CLIENT_ID=CHANGE_ME
FLIPKART_CLIENT_SECRET=CHANGE_ME
MEESHO_API_KEY=CHANGE_ME
