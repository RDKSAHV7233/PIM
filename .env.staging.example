APP_ENV="staging"
PORT="4000"

PIM_API_BASE_URL="https://<railway-api-service>.up.railway.app/api/v1"
CORS_ORIGIN="https://<railway-web-service>.up.railway.app"
AUTH_MODE="db"

DATABASE_URL_POOLED="postgresql://postgres:<password>@<railway-postgres-host>:5432/railway?schema=public"
DATABASE_URL_DIRECT="postgresql://postgres:<password>@<railway-postgres-host>:5432/railway?schema=public"
DB_POOL_APP_NAME="tej-pim-api-staging"

JWT_SECRET="replace-with-staging-secret-at-least-32-chars"
JWT_EXPIRY="4h"
JWT_BLOCKLIST_KEY_PREFIX="jti:"
REDIS_URL="redis://default:<password>@<railway-redis-host>:6379"
QUEUE_BACKEND="bullmq"
QUEUE_WORKER_ENABLED="true"
PIM_AUTH_REDIS_DISABLED="false"
JWT_BLOCKLIST_REDIS_DISABLED="false"
CACHE_REDIS_DISABLED="false"
DASHBOARD_CACHE_REDIS_DISABLED="false"

CREDENTIAL_ENCRYPTION_KEY_V1="replace-with-base64-key"
CREDENTIAL_ENCRYPTION_KEY_V2=""
CREDENTIAL_ENCRYPTION_KEY_CURRENT_VERSION="1"

# Media storage — choose one of two modes:
#
# Option A — Cloudflare R2 (recommended for persistent staging):
#   Set R2_* vars and leave MEDIA_LOCAL_FALLBACK unset or "false".
#   Create bucket at dash.cloudflare.com → R2 → Create bucket.
#
# Option B — Local filesystem fallback (quick staging without R2):
#   Set MEDIA_LOCAL_FALLBACK="true" and mount a Railway volume at /app/storage/media.
#   Without the volume mount, uploads survive the session but are wiped on redeploy.
#   Go to: Railway dashboard → API service → Settings → Volumes → Mount at /app/storage/media
#
MEDIA_LOCAL_FALLBACK="true"   # set to "false" or remove once R2 is configured
R2_ACCOUNT_ID="replace-me"
R2_ACCESS_KEY_ID="replace-me"
R2_SECRET_ACCESS_KEY="replace-me"
R2_BUCKET_NAME="tej-pim-media-staging"
R2_PUBLIC_URL="https://media-staging.example.com"
ACCOUNT_EXPORT_STORAGE_MODE="auto" # set to "filesystem" to store account exports on a mounted Railway volume
ACCOUNT_EXPORT_STORAGE_DIR="" # required in staging when ACCOUNT_EXPORT_STORAGE_MODE=filesystem

# Email delivery - use "resend" for realistic staging; "console" is acceptable only
# for non-commercial staging environments where boot health matters more than delivery.
AUTH_EMAIL_PROVIDER="resend"
AUTH_EMAIL_RESEND_API_KEY="replace-me"
AUTH_EMAIL_FROM="noreply@example.com"
AUTH_EMAIL_REPLY_TO=""
PIM_COMMERCIAL_CONTACT_URL="https://vexapim.com/contact"
PIM_COMMERCIAL_CONTACT_EMAIL="billing@vexapim.com"
PIM_COMMERCIAL_OPS_TOKEN="replace-with-staging-commercial-ops-token"
PIM_COMMERCIAL_TRIAL_DAYS="14"

FEATURE_REAL_SPAPI_VALIDATION="false"
FEATURE_ONDC_ENABLED="false"
FEATURE_PUBLIC_SIGNUP_ENABLED="false"
NEXT_PUBLIC_FEATURE_PUBLIC_SIGNUP_ENABLED="false"
NEXT_PUBLIC_FEATURE_ONDC_ENABLED="false"
CONNECTOR_STUB_SLUGS=""
NEXT_PUBLIC_CONNECTOR_STUB_SLUGS=""
AMAZON_CLIENT_ID=""
AMAZON_CLIENT_SECRET=""
FLIPKART_CLIENT_ID=""
FLIPKART_CLIENT_SECRET=""
MEESHO_MERCHANT_ID=""
MEESHO_SECRET_KEY=""

# ── Playwright / Demo / Staging email outbox ─────────────────────────
# Required for signup/commercial Playwright tests. Set to a writable directory path.
# Wrapper scripts (scripts/run-playwright-*.cjs) create a temp dir automatically.
# For persistent staging demo: set to a stable path like /tmp/vexa-pim-signup-outbox
# Set AUTH_EMAIL_PROVIDER="file" to write emails to the outbox dir instead of sending via resend.
PLAYWRIGHT_SIGNUP_OUTBOX_DIR="" # leave empty in production; set for demo/staging test runs
# AUTH_EMAIL_PROVIDER: local | resend | file (file = writes emails to PLAYWRIGHT_SIGNUP_OUTBOX_DIR)
AUTH_EMAIL_OUTBOX_DIR="" # mirror of PLAYWRIGHT_SIGNUP_OUTBOX_DIR; set both together
