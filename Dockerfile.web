# ── Stage 1a: install all dependencies (needed for build) ────────────────────
FROM node:20-alpine AS deps
WORKDIR /app

# Copy workspace manifests
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/db/package.json ./packages/db/

# Install all workspace dependencies.
# REDISMS_DISABLE_POSTINSTALL=1 skips redis-memory-server's postinstall hook,
# which tries to compile native Redis binaries with `make` (not present in
# the Alpine image). The package is only used in tests; production never
# loads it. See: https://github.com/mhassan1/redis-memory-server#configuration
ENV REDISMS_DISABLE_POSTINSTALL=1
RUN npm ci

# ── Stage 1b: production-only dependencies ────────────────────────────────────
FROM node:20-alpine AS prod-deps
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/db/package.json ./packages/db/

ENV REDISMS_DISABLE_POSTINSTALL=1
RUN npm ci --omit=dev

# ── Stage 2: build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

# Copy installed node_modules from deps stage.
# packages/db/node_modules may not exist if npm hoisted all db deps to root;
# ensure the directory exists before copying.
RUN mkdir -p packages/db/node_modules
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules

# Copy full monorepo source so Next.js output file tracing (outputFileTracingRoot) works
COPY . .

# PIM_API_BASE_URL is the canonical server-side upstream URL for SSR and proxy
# routes. NEXT_PUBLIC_API_URL remains supported as a legacy fallback.
#
# When a client-side build path needs the public API origin, Railway can also
# inject NEXT_PUBLIC_API_URL at build time.
ARG PIM_API_BASE_URL
ENV PIM_API_BASE_URL=${PIM_API_BASE_URL}
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

# Build the Next.js web app
RUN npm run build --workspace @pim1/web

# ── Stage 3: production runner ────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ARG PIM_API_BASE_URL
ENV PIM_API_BASE_URL=${PIM_API_BASE_URL}
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ARG PIM_API_BASE_URL_FALLBACK
ENV PIM_API_BASE_URL_FALLBACK=${PIM_API_BASE_URL_FALLBACK}

# Copy root package.json + workspace manifests (needed by `npm run start`)
COPY package.json ./
COPY apps/web/package.json ./apps/web/

# Copy production-only web node_modules
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=prod-deps /app/apps/web/node_modules ./apps/web/node_modules

# Copy the Next.js build output and public assets
COPY --from=build /app/apps/web/.next ./apps/web/.next
COPY --from=build /app/apps/web/public ./apps/web/public

EXPOSE 3000

CMD ["npm", "run", "start", "--workspace", "@pim1/web"]
