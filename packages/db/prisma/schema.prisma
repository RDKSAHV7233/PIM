  @@index([tenantKey, installationId, categoryScope, lifecycleState], map: "idx_connector_mapping_versions_installation")
  // idx_connector_mapping_versions_one_published: DB-only, not representable here.
  // It's a partial unique index on (tenantKey, connectorSlug, categoryScope,
  // COALESCE(installationId, '')) WHERE lifecycleState = 'published' — Prisma's
  // @@unique can't express a COALESCE key or a WHERE predicate. Defined in
