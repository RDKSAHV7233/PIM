generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  draft
  in_review
  approved
  rejected
  active
  archived
}

enum AttributeDataType {
  text
  number
  boolean
  select
  json
}

enum AppliesTo {
  product
  variant
}

enum RuleSeverity {
  error
  warning
}

enum RuleType {
  required_field
  regex_field
  value_in_set
}

enum ValidationIssueStatus {
  open
  resolved
}

enum ExportJobStatus {
  queued
  processing
  retrying
  skipped
  completed
  failed
  dead_letter
}

enum BulkImportJobStatus {
  queued
  processing
  retrying
  completed
  failed
  dead_letter
}

enum BulkImportRowStatus {
  queued
  processing
  success
  retrying
  failed
  dead_letter
}

enum BulkEditOperationStatus {
  queued
  processing
  completed
  completed_with_errors
  failed
}

enum BulkImportRunStatus {
  uploaded
  validating
  preflight_blocked
  preflight_ready
  processing
  completed
  repair_required
  failed
}

enum BulkImportRunMode {
  standard
  large
}

enum BulkImportJobRole {
  standard
  large_batch
}

enum BulkEditItemStatus {
  success
  failed
}

enum AiExecutionStatus {
  queued
  validating
  blocked
  running
  succeeded
  failed
  timed_out
  budget_blocked
  provider_disabled
  cancelled
}

enum AiExecutionCostSource {
  none
  estimated
  actual
  provider
}

enum AiExecutionFailureClass {
  validation_error
  classification_blocked
  redaction_failed
  tenant_policy_blocked
  budget_exhausted
  provider_disabled
  provider_timeout
  provider_rate_limited
  provider_auth_error
  provider_5xx
  provider_schema_invalid
  unsafe_output
  internal_error
}

enum AiSuggestionStatus {
  generated
  pending_review
  accepted
  edited
  rejected
  blocked_stale
  blocked_tampered
  blocked_unauthorized
  applied
}

enum AiSuggestionReviewDecision {
  accept
  edit
  reject
}

enum AiDataClassification {
  AI_ALLOWED
  AI_ALLOWED_WITH_REDACTION
  AI_BLOCKED
}

enum AiTenantPolicyStatus {
  draft
  active
  disabled
}

// Bulk-Publish Goes Async, Story 2. Mirrors BulkImportRunStatus/BulkEditOperationStatus —
// same shape for the same reason: a run that queues work for a worker to process later.
enum MarketplaceBulkPublishRunStatus {
  queued
  processing
  completed
  completed_with_errors
  failed
}

// One row per product in a run. "excluded" (failed the eligibility/readiness gate before
// ever being queued) is distinct from "failed" (queued, attempted, the connector call
// itself failed) — the retry-failed UI action (Story 7) only ever targets "failed", never
// "excluded", since re-queuing an ineligible product would just fail again for the same
// reason.
enum MarketplaceBulkPublishItemStatus {
  pending
  queued
  succeeded
  failed
  excluded
}

enum ConnectorPermissionPrincipalType {
  user
  role
}

enum ConnectorPermissionAction {
  install
  reconnect
  uninstall
}

enum AccessScopeSubjectType {
  user
  role
}

enum AccessScopeType {
  category
  brand
  channel
  connector_account
  vendor
  owner
  supplier
  locale
  market
  catalog
  team
  assignee
}

model Category {
  id                   String                @id @default(cuid())
  tenantKey            String                @default("default")
  name                 String
  slug                 String
  path                 String
  parentId             String?
  parent               Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children             Category[]            @relation("CategoryHierarchy")
  products             Product[]
  attributeDefinitions AttributeDefinition[]
  complianceRules      ComplianceRule[]
  mappingTemplates     ChannelMappingTemplate[]
  exportJobs           MarketplaceExportJob[]
  bulkImportJobs       BulkImportJob[]
  bulkImportTemplates  BulkImportTemplate[]
  bulkImportRuns       BulkImportRun[]
  accessScopeAssignments AccessScopeAssignment[]
  translations         CategoryTranslation[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([parentId])
  @@index([path])
  @@index([tenantKey])
  @@unique([tenantKey, slug])
}

model BulkImportTemplate {
  id          String   @id @default(cuid())
  tenantKey   String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  version     Int      @default(1)
  sourceFormat String
  mapping     Json
  schemaSnapshot Json?
  chunkSize   Int      @default(100)
  maxRetries  Int      @default(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantKey, categoryId, name, version])
  @@index([tenantKey, categoryId, name, version])
  @@index([tenantKey, categoryId, updatedAt])
}

model Product {
  id               String            @id @default(cuid())
  tenantKey        String            @default("default")
  title            String
  description      String            @default("")
  brand            String            @default("")
  vendorScopeKey   String?           @map("vendor_scope_key")
  status           RecordStatus      @default(draft)
  version          Int               @default(1)
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  hsnCode          String?
  gstRate          Float?
  attributes       Json              @default("{}")
  assigneeId       String?           @map("assignee_id")
  slaDeadlineAt    DateTime?         @map("sla_deadline_at")
  variants         Variant[]
  translations     ProductTranslation[]
  mediaAssets      MediaAsset[]
  validationIssues  ValidationIssue[] @relation("ProductValidationIssues")
  exportJobs        MarketplaceExportJob[]
  importedRows      BulkImportRow[]
  bulkEditItems     BulkEditOperationItem[]
  bulkPublishItems  MarketplaceBulkPublishRunItem[]
  changeRequests    ChangeRequest[]
  relationshipsFrom ProductRelationship[] @relation("RelationshipSource")
  relationshipsTo   ProductRelationship[] @relation("RelationshipTarget")
  taxCodes          ProductTaxCode[]
  deletedAt         DateTime?
  purgedById       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([hsnCode])
  @@index([vendorScopeKey])
  @@index([tenantKey])
  @@index([tenantKey, vendorScopeKey])
  @@index([tenantKey, status])
  @@index([tenantKey, deletedAt])
  @@index([tenantKey, assigneeId])
  @@index([tenantKey, slaDeadlineAt])
  @@index([tenantKey, deletedAt, updatedAt(sort: Desc), id(sort: Desc)], map: "idx_product_tenant_deleted_updated_id")
  // Delta-sync candidate scan: WHERE tenantKey=X AND status='approved' AND deletedAt IS NULL AND id > cursor ORDER BY id ASC
  // Without this, fetchDeltaCandidatesPage does a full scan of [tenantKey,status] on every 200-row page.
  @@index([tenantKey, status, deletedAt, id], map: "idx_product_delta_sync_scan")
}

model Variant {
  id               String            @id @default(cuid())
  tenantKey        String            @default("default")
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuCode          String
  mediaAssets      MediaAsset[]
  attributes       Json              @default("{}")
  prices           ProductPrice[]
  mrp              Float?
  sellingPrice     Float?
  inventoryQty     Int               @default(0)
  status           RecordStatus      @default(draft)
  validationIssues ValidationIssue[] @relation("VariantValidationIssues")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([productId])
  @@index([status])
  @@index([tenantKey])
  @@unique([tenantKey, skuCode])
}

model MediaAsset {
  id         String   @id
  tenantKey  String   @default("default") @map("tenant_key")
  productId  String?  @map("product_id")
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId  String?  @map("variant_id")
  variant    Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  entityType String   @default("product") @map("entity_type")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  storagePath String  @map("storage_path")
  width      Int?
  height     Int?
  sizeBytes  Int      @map("size_bytes")
  checksum   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@index([tenantKey], map: "idx_media_assets_tenant_key")
  @@index([tenantKey, createdAt(sort: Desc)], map: "idx_media_assets_tenant_created_at")
  @@index([productId, createdAt(sort: Desc)], map: "idx_media_assets_product_created_at")
  @@index([variantId, createdAt(sort: Desc)], map: "idx_media_assets_variant_created_at")
  @@map("media_assets")
}

model MediaIntegrityScanRun {
  id                  String    @id @default(cuid())
  status              String
  mode                String    @default("read_only")
  startedAt           DateTime  @default(now()) @map("started_at")
  completedAt         DateTime? @map("completed_at")
  cursorCreatedAt     DateTime? @map("cursor_created_at")
  cursorId            String?   @map("cursor_id")
  rowsExamined        Int       @default(0) @map("rows_examined")
  rowsEligible        Int?      @map("rows_eligible")
  coverageComplete    Boolean   @default(false) @map("coverage_complete")
  truncated           Boolean   @default(false)
  continuationPending Boolean   @default(false) @map("continuation_pending")
  limits              Json      @default("{}")
  storage             Json      @default("{}")
  totals              Json      @default("{}")
  byStorageKind       Json      @default("{}") @map("by_storage_kind")
  impact              Json      @default("{}")
  safety              Json      @default("{}")
  errorMessage        String?   @map("error_message")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([startedAt(sort: Desc)], map: "idx_media_integrity_runs_started")
  @@index([status, startedAt(sort: Desc)], map: "idx_media_integrity_runs_status_started")
  @@map("media_integrity_scan_runs")
}

model MediaIntegrityScanCheckpoint {
  checkpointKey   String    @id @map("checkpoint_key")
  cursorCreatedAt DateTime? @map("cursor_created_at")
  cursorId        String?   @map("cursor_id")
  lastRunId       String?   @map("last_run_id")
  cycleStartedAt  DateTime  @default(now()) @map("cycle_started_at")
  rowsEligible    Int?      @map("rows_eligible")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("media_integrity_scan_checkpoints")
}

model AttributeDefinition {
  id            String            @id @default(cuid())
  tenantKey     String            @default("default")
  categoryId    String
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key           String
  name          String
  dataType      AttributeDataType
  required      Boolean           @default(false)
  allowedValues Json?
  appliesTo     AppliesTo         @default(product)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([categoryId, key, appliesTo])
  @@index([categoryId, appliesTo])
  @@index([categoryId])
  @@index([appliesTo])
  @@index([tenantKey])
}

model ComplianceRule {
  id        String           @id @default(cuid())
  tenantKey String           @default("default")
  ruleCode  String           @unique
  name      String
  categoryId String?
  category  Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  severity  RuleSeverity     @default(error)
  ruleType  RuleType
  config    Json
  active    Boolean          @default(true)
  issues    ValidationIssue[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([categoryId, active])
  @@index([ruleType])
  @@index([tenantKey])
}

model ValidationIssue {
  id        String                @id @default(cuid())
  tenantKey String                @default("default")
  productId String
  product   Product               @relation("ProductValidationIssues", fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   Variant?              @relation("VariantValidationIssues", fields: [variantId], references: [id], onDelete: Cascade)
  ruleId    String?
  rule      ComplianceRule?       @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  severity  RuleSeverity
  ruleCode  String
  message   String
  fieldPath String?
  status    ValidationIssueStatus @default(open)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([productId])
  @@index([variantId])
  @@index([status])
  @@index([ruleCode])
  @@index([tenantKey])
  // Composite indexes for the issue inbox query (filter: tenantKey + status, order: severity, createdAt, id)
  @@index([tenantKey, status, productId])
  @@index([tenantKey, severity, status])
  // Optimised for product-list issue count: WHERE tenantKey = ? AND productId IN (?) AND status = ?
  @@index([tenantKey, productId, status])
}

model ChannelMappingTemplate {
  id             String               @id @default(cuid())
  tenantKey      String               @default("default")
  name           String
  isSystemPack   Boolean              @default(false)
  createdBy      String?
  version        Int                  @default(1)
  parentTemplateId String?
  categoryId     String
  category       Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  channel        String               @db.VarChar(64)
  requiredFields Json
  fieldMap       Json
  isDefault      Boolean              @default(false)
  jobs           MarketplaceExportJob[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([categoryId, channel, name])
  @@index([categoryId, channel])
  @@index([tenantKey, channel, version])
  @@index([parentTemplateId])
  @@index([tenantKey])
}

model MarketplaceExportJob {
  id           String                 @id @default(cuid())
  tenantKey    String                 @default("default")
  createdBy    String?                @map("created_by")
  productId    String
  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  channel      String                 @db.VarChar(64)
  templateId   String?
  template     ChannelMappingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status       ExportJobStatus        @default(queued)
  retryCount   Int                    @default(0)
  maxRetries   Int                    @default(3)
  failureReason String?
  dlqReason    String?
  payload        Json?
  exportPayload  Json?
  installationId String?              @map("installation_id")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([productId, channel])
  @@index([status, updatedAt])
  @@index([templateId])
  @@index([tenantKey])
  @@index([tenantKey, createdBy, updatedAt])
  @@index([installationId])
  // Composite indexes for multi-tenant job worker polling (filter: tenantKey + status)
  @@index([tenantKey, status, channel])
  @@index([tenantKey, status, updatedAt])
  // Partial unique index (active states only) — managed by raw SQL migration
  // 20260713000001_active_export_job_partial_unique.  Prisma cannot express WHERE
  // clauses on indexes, so the constraint lives outside the schema DSL.
}

model BulkImportJob {
  id             String              @id @default(cuid())
  tenantKey      String              @default("default")
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  runId          String?
  run            BulkImportRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  batchIndex     Int?
  rowStart       Int?
  rowEnd         Int?
  jobRole        BulkImportJobRole   @default(standard)
  sourceFormat   String
  sourceName     String?
  mapping        Json
  chunkSize      Int                 @default(100)
  maxRetries     Int                 @default(3)
  status         BulkImportJobStatus @default(queued)
  totalRows      Int                 @default(0)
  processedRows  Int                 @default(0)
  successRows    Int                 @default(0)
  failedRows     Int                 @default(0)
  deadLetterRows Int                 @default(0)
  rows           BulkImportRow[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([categoryId])
  @@index([status, updatedAt])
  @@index([tenantKey])
  @@index([tenantKey, status, updatedAt])
  @@index([tenantKey, runId, status])
}

model BulkImportRow {
  id                 String              @id @default(cuid())
  tenantKey          String              @default("default")
  jobId              String
  job                BulkImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  runId              String?
  run                BulkImportRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  rowNumber          Int
  rowNumberGlobal    Int?
  rowNumberInBatch   Int?
  payload            Json
  status             BulkImportRowStatus @default(queued)
  retryCount         Int                 @default(0)
  errorMessage       String?
  productId          String?
  product            Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  lastAttemptAt      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([jobId, rowNumber])
  @@index([jobId, status, rowNumber])
  @@index([productId])
  @@index([tenantKey])
  @@index([tenantKey, runId, status])
}

model BulkImportRun {
  id                   String               @id @default(cuid())
  tenantKey            String               @default("default")
  categoryId           String
  category             Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status               BulkImportRunStatus  @default(uploaded)
  sourceFileKey        String
  sourceName           String?
  sourceFormat         String
  sourceFileSizeBytes  Int                  @default(0)
  sourceExpiresAt      DateTime?
  totalRows            Int                  @default(0)
  acceptedRows         Int                  @default(0)
  failedRows           Int                  @default(0)
  deadLetterRows       Int                  @default(0)
  blockingIssueCount   Int                  @default(0)
  warningCount         Int                  @default(0)
  estimatedBatchCount  Int                  @default(0)
  effectiveMode        BulkImportRunMode?
  preflightSummary     Json?
  maxRetries           Int                  @default(3)
  rows                 BulkImportRow[]
  jobs                 BulkImportJob[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([tenantKey, status, createdAt])
  @@index([tenantKey, categoryId, createdAt])
}

model BulkEditOperation {
  id             String                  @id @default(cuid())
  tenantKey      String                  @default("default")
  status         BulkEditOperationStatus @default(queued)
  scope          Json
  updates        Json
  requestedCount Int                     @default(0)
  appliedCount   Int                     @default(0)
  failedCount    Int                     @default(0)
  items          BulkEditOperationItem[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status, updatedAt])
  @@index([tenantKey])
  @@index([tenantKey, status, updatedAt])
}

model BulkEditOperationItem {
  id          String             @id @default(cuid())
  tenantKey   String             @default("default")
  operationId String
  operation   BulkEditOperation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  status      BulkEditItemStatus
  before      Json
  after       Json?
  errorMessage String?
  // CTO review follow-up (PR #719, 2026-09-05): a plan-limit failure (e.g.
  // enforceSkuLimitForApproval) used to collapse into errorMessage as a plain string,
  // so the client had no way to distinguish it from any other failure and never showed
  // the same upgrade CTA the single-product/export/media flows show for the identical
  // condition. errorCode carries a machine-readable discriminator ("PLAN_LIMIT_EXCEEDED",
  // etc.); errorDetails carries the same structured shape those other flows already
  // return over HTTP (resource, limit, current, upgrade_url, contact_url) so the client
  // can render one shared component instead of parsing errorMessage text.
  errorCode    String?
  errorDetails Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([operationId, status])
  @@index([productId])
  @@index([tenantKey])
}

// Bulk-Publish Goes Async, Story 2 — the schema gap review caught: a parent run record
// alone can't back resumability or per-product retry, there was nowhere for either to
// actually read or write state. Mirrors BulkImportRun/BulkEditOperationItem's run+item
// split exactly, not a new pattern.
model MarketplaceBulkPublishRun {
  id             String                          @id @default(cuid())
  tenantKey      String                          @default("default")
  installationId String
  connectorSlug  String
  channel        String
  requestedCount Int                             @default(0)
  succeededCount Int                             @default(0)
  failedCount    Int                             @default(0)
  excludedCount  Int                             @default(0)
  status         MarketplaceBulkPublishRunStatus @default(queued)
  createdBy      String?
  items          MarketplaceBulkPublishRunItem[]
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt

  @@index([tenantKey, status, createdAt])
  @@index([tenantKey, installationId])
}

model MarketplaceBulkPublishRunItem {
  id             String                            @id @default(cuid())
  tenantKey      String                            @default("default")
  runId          String
  run            MarketplaceBulkPublishRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  productId      String
  product        Product                           @relation(fields: [productId], references: [id], onDelete: Cascade)
  status         MarketplaceBulkPublishItemStatus  @default(pending)
  exportJobId    String?
  idempotencyKey String
  attemptCount   Int                               @default(0)
  retryEligible  Boolean                           @default(true)
  reason         String?
  // Set when an item is claimed (pending -> queued) so a crashed/killed worker can't
  // strand it forever: the claim query below only matches `pending` items, so without
  // this timestamp a `queued` item whose worker died mid-processing would never be
  // picked up by any future redelivery. processBulkPublishRun's claim query also
  // re-claims `queued` items whose claimedAt is older than the reclaim threshold.
  claimedAt      DateTime?
  createdAt      DateTime                          @default(now())
  updatedAt      DateTime                          @updatedAt

  // One row per product per run — the worker's resumability (Story 4) depends on this:
  // redelivery re-processes the run, finds the existing item by (runId, productId), and
  // skips it if already terminal instead of creating a duplicate.
  @@unique([runId, productId])
  @@index([runId, status])
  @@index([tenantKey])
  @@index([productId])
}

model AccountConsentEvent {
  id               String   @id
  tenantKey        String   @default("default") @map("tenant_key")
  userId           String   @map("user_id")
  accepted         Boolean
  policyVersion    String   @default("dpdp-v1") @map("policy_version")
  purpose          String   @default("account_access")
  consentRecordedAt DateTime @default(now()) @map("consent_recorded_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([tenantKey, userId, createdAt(sort: Desc)], map: "idx_account_consent_events_tenant_user_created")
  @@map("account_consent_events")
}

model AccountExportRequest {
  id                     String   @id
  tenantKey              String   @default("default") @map("tenant_key")
  userId                 String   @map("user_id")
  actorRole              String   @map("actor_role")
  format                 String
  status                 String   @default("queued")
  requestedAt            DateTime @default(now()) @map("requested_at")
  estimatedReadyInSeconds Int     @default(120) @map("estimated_ready_in_seconds")
  artifactPath           String?  @map("artifact_path")
  artifactFileName       String?  @map("artifact_file_name")
  completedAt            DateTime? @map("completed_at")
  failedAt               DateTime? @map("failed_at")
  errorMessage           String?  @map("error_message")
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([tenantKey, userId, requestedAt(sort: Desc)], map: "idx_account_export_requests_tenant_user_requested")
  @@map("account_export_requests")
}

model AuthRecoveryToken {
  id         String   @id
  tenantKey  String   @default("default")
  userId     String
  purpose    String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantKey, userId, purpose, createdAt(sort: Desc)], map: "idx_auth_recovery_token_lookup")
}

model AccountDeletionRequest {
  id          String   @id
  tenantKey   String   @default("default") @map("tenant_key")
  userId      String   @map("user_id")
  actorRole   String   @map("actor_role")
  reason      String?
  status      String   @default("scheduled")
