generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  draft
  in_review
  approved
  rejected
  active
  archived
}

enum AttributeDataType {
  text
  number
  boolean
  select
  json
}

enum AppliesTo {
  product
  variant
}

enum RuleSeverity {
  error
  warning
}

enum RuleType {
  required_field
  regex_field
  value_in_set
}

enum ValidationIssueStatus {
  open
  resolved
}

enum ExportJobStatus {
  queued
  processing
  retrying
  skipped
  completed
  failed
  dead_letter
}

enum BulkImportJobStatus {
  queued
  processing
  retrying
  completed
  failed
  dead_letter
}

enum BulkImportRowStatus {
  queued
  processing
  success
  retrying
  failed
  dead_letter
}

enum BulkEditOperationStatus {
  processing
  completed
  failed
}

enum BulkImportRunStatus {
  uploaded
  validating
  preflight_blocked
  preflight_ready
  processing
  completed
  repair_required
  failed
}

enum BulkImportJobRole {
  standard
  large_batch
}

enum BulkEditItemStatus {
  success
  failed
}

enum ConnectorPermissionPrincipalType {
  user
  role
}

enum ConnectorPermissionAction {
  install
  reconnect
  uninstall
}

enum AccessScopeSubjectType {
  user
  role
}

enum AccessScopeType {
  category
  brand
  channel
  connector_account
  vendor
  owner
  supplier
  locale
  market
  catalog
  team
  assignee
}

model Category {
  id                   String                @id @default(cuid())
  tenantKey            String                @default("default")
  name                 String
  slug                 String
  path                 String
  parentId             String?
  parent               Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children             Category[]            @relation("CategoryHierarchy")
  products             Product[]
  attributeDefinitions AttributeDefinition[]
  complianceRules      ComplianceRule[]
  mappingTemplates     ChannelMappingTemplate[]
  exportJobs           MarketplaceExportJob[]
  bulkImportJobs       BulkImportJob[]
  bulkImportTemplates  BulkImportTemplate[]
  bulkImportRuns       BulkImportRun[]
  accessScopeAssignments AccessScopeAssignment[]
  translations         CategoryTranslation[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([parentId])
  @@index([path])
  @@index([tenantKey])
  @@unique([tenantKey, slug])
}

model BulkImportTemplate {
  id          String   @id @default(cuid())
  tenantKey   String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  version     Int      @default(1)
  sourceFormat String
  mapping     Json
  schemaSnapshot Json?
  chunkSize   Int      @default(100)
  maxRetries  Int      @default(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantKey, categoryId, name, version])
  @@index([tenantKey, categoryId, name, version])
  @@index([tenantKey, categoryId, updatedAt])
}

model Product {
  id               String            @id @default(cuid())
  tenantKey        String            @default("default")
  title            String
  description      String            @default("")
  brand            String            @default("")
  vendorScopeKey   String?           @map("vendor_scope_key")
  status           RecordStatus      @default(draft)
  version          Int               @default(1)
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  hsnCode          String?
  gstRate          Float?
  attributes       Json              @default("{}")
  assigneeId       String?           @map("assignee_id")
  slaDeadlineAt    DateTime?         @map("sla_deadline_at")
  variants         Variant[]
  translations     ProductTranslation[]
  mediaAssets      MediaAsset[]
  validationIssues  ValidationIssue[] @relation("ProductValidationIssues")
  exportJobs        MarketplaceExportJob[]
  importedRows      BulkImportRow[]
  bulkEditItems     BulkEditOperationItem[]
  changeRequests    ChangeRequest[]
  relationshipsFrom ProductRelationship[] @relation("RelationshipSource")
  relationshipsTo   ProductRelationship[] @relation("RelationshipTarget")
  deletedAt         DateTime?
  purgedById       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([hsnCode])
  @@index([vendorScopeKey])
  @@index([tenantKey])
  @@index([tenantKey, vendorScopeKey])
  @@index([tenantKey, status])
  @@index([tenantKey, deletedAt])
  @@index([tenantKey, assigneeId])
  @@index([tenantKey, slaDeadlineAt])
  @@index([tenantKey, deletedAt, updatedAt(sort: Desc), id(sort: Desc)], map: "idx_product_tenant_deleted_updated_id")
  // Delta-sync candidate scan: WHERE tenantKey=X AND status='approved' AND deletedAt IS NULL AND id > cursor ORDER BY id ASC
  // Without this, fetchDeltaCandidatesPage does a full scan of [tenantKey,status] on every 200-row page.
  @@index([tenantKey, status, deletedAt, id], map: "idx_product_delta_sync_scan")
}

model Variant {
  id               String            @id @default(cuid())
  tenantKey        String            @default("default")
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuCode          String
  mediaAssets      MediaAsset[]
  attributes       Json              @default("{}")
  prices           ProductPrice[]
  mrp              Float?
  sellingPrice     Float?
  inventoryQty     Int               @default(0)
  status           RecordStatus      @default(draft)
  validationIssues ValidationIssue[] @relation("VariantValidationIssues")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([productId])
  @@index([status])
  @@index([tenantKey])
  @@unique([tenantKey, skuCode])
}

model MediaAsset {
  id         String   @id
  tenantKey  String   @default("default") @map("tenant_key")
  productId  String?  @map("product_id")
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId  String?  @map("variant_id")
  variant    Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  entityType String   @default("product") @map("entity_type")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  storagePath String  @map("storage_path")
  width      Int?
  height     Int?
  sizeBytes  Int      @map("size_bytes")
  checksum   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@index([tenantKey], map: "idx_media_assets_tenant_key")
  @@index([tenantKey, createdAt(sort: Desc)], map: "idx_media_assets_tenant_created_at")
  @@index([productId, createdAt(sort: Desc)], map: "idx_media_assets_product_created_at")
  @@index([variantId, createdAt(sort: Desc)], map: "idx_media_assets_variant_created_at")
  @@map("media_assets")
}

model AttributeDefinition {
  id            String            @id @default(cuid())
  tenantKey     String            @default("default")
  categoryId    String
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key           String
  name          String
  dataType      AttributeDataType
  required      Boolean           @default(false)
  allowedValues Json?
  appliesTo     AppliesTo         @default(product)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([categoryId, key, appliesTo])
  @@index([categoryId, appliesTo])
  @@index([categoryId])
  @@index([appliesTo])
  @@index([tenantKey])
}

model ComplianceRule {
  id        String           @id @default(cuid())
  tenantKey String           @default("default")
  ruleCode  String           @unique
  name      String
  categoryId String?
  category  Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  severity  RuleSeverity     @default(error)
  ruleType  RuleType
  config    Json
  active    Boolean          @default(true)
  issues    ValidationIssue[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([categoryId, active])
  @@index([ruleType])
  @@index([tenantKey])
}

model ValidationIssue {
  id        String                @id @default(cuid())
  tenantKey String                @default("default")
  productId String
  product   Product               @relation("ProductValidationIssues", fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   Variant?              @relation("VariantValidationIssues", fields: [variantId], references: [id], onDelete: Cascade)
  ruleId    String?
  rule      ComplianceRule?       @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  severity  RuleSeverity
  ruleCode  String
  message   String
  fieldPath String?
  status    ValidationIssueStatus @default(open)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([productId])
  @@index([variantId])
  @@index([status])
  @@index([ruleCode])
  @@index([tenantKey])
  // Composite indexes for the issue inbox query (filter: tenantKey + status, order: severity, createdAt, id)
  @@index([tenantKey, status, productId])
  @@index([tenantKey, severity, status])
}

model ChannelMappingTemplate {
  id             String               @id @default(cuid())
  tenantKey      String               @default("default")
  name           String
  isSystemPack   Boolean              @default(false)
  createdBy      String?
  version        Int                  @default(1)
  parentTemplateId String?
  categoryId     String
  category       Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  channel        String               @db.VarChar(64)
  requiredFields Json
  fieldMap       Json
  isDefault      Boolean              @default(false)
  jobs           MarketplaceExportJob[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([categoryId, channel, name])
  @@index([categoryId, channel])
  @@index([tenantKey, channel, version])
  @@index([parentTemplateId])
  @@index([tenantKey])
}

model MarketplaceExportJob {
  id           String                 @id @default(cuid())
  tenantKey    String                 @default("default")
  createdBy    String?                @map("created_by")
  productId    String
  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  channel      String                 @db.VarChar(64)
  templateId   String?
  template     ChannelMappingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status       ExportJobStatus        @default(queued)
  retryCount   Int                    @default(0)
  maxRetries   Int                    @default(3)
  failureReason String?
  dlqReason    String?
  payload        Json?
  exportPayload  Json?
  installationId String?              @map("installation_id")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([productId, channel])
  @@index([status, updatedAt])
  @@index([templateId])
  @@index([tenantKey])
  @@index([tenantKey, createdBy, updatedAt])
  @@index([installationId])
  // Composite indexes for multi-tenant job worker polling (filter: tenantKey + status)
  @@index([tenantKey, status, channel])
  @@index([tenantKey, status, updatedAt])
  // Partial unique index for delta-sync idempotency: one pending/processing job per
  // product per installation.  installationId IS NOT NULL rows only (enforced in the
  // raw-SQL migration via a WHERE clause); manual export jobs (installationId=NULL)
  // are unaffected.  Enables upsert semantics in queueDeltaSync.
  @@unique([tenantKey, productId, installationId], map: "uq_export_job_product_installation")
}

model BulkImportJob {
  id             String              @id @default(cuid())
  tenantKey      String              @default("default")
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  runId          String?
  run            BulkImportRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  batchIndex     Int?
  rowStart       Int?
  rowEnd         Int?
  jobRole        BulkImportJobRole   @default(standard)
  sourceFormat   String
  sourceName     String?
  mapping        Json
  chunkSize      Int                 @default(100)
  maxRetries     Int                 @default(3)
  status         BulkImportJobStatus @default(queued)
  totalRows      Int                 @default(0)
  processedRows  Int                 @default(0)
  successRows    Int                 @default(0)
  failedRows     Int                 @default(0)
  deadLetterRows Int                 @default(0)
  rows           BulkImportRow[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([categoryId])
  @@index([status, updatedAt])
  @@index([tenantKey])
  @@index([tenantKey, status, updatedAt])
  @@index([tenantKey, runId, status])
}

model BulkImportRow {
  id                 String              @id @default(cuid())
  tenantKey          String              @default("default")
  jobId              String
  job                BulkImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  runId              String?
  rowNumber          Int
  rowNumberGlobal    Int?
  rowNumberInBatch   Int?
  payload            Json
  status             BulkImportRowStatus @default(queued)
  retryCount         Int                 @default(0)
  errorMessage       String?
  productId          String?
  product            Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  lastAttemptAt      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([jobId, rowNumber])
  @@index([jobId, status, rowNumber])
  @@index([productId])
  @@index([tenantKey])
  @@index([tenantKey, runId, status])
}

model BulkImportRun {
  id                   String               @id @default(cuid())
  tenantKey            String               @default("default")
  categoryId           String
  category             Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status               BulkImportRunStatus  @default(uploaded)
  sourceFileKey        String?
  sourceName           String?
  sourceFormat         String               @default("csv")
  sourceFileSizeBytes  Int?
  sourceExpiresAt      DateTime?
  totalRows            Int?
  acceptedRows         Int?
  failedRows           Int?
  deadLetterRows       Int?
  blockingIssueCount   Int?
  warningCount         Int?
  estimatedBatchCount  Int?
  effectiveMode        String?
  preflightSummary     Json?
  maxRetries           Int                  @default(3)
  jobs                 BulkImportJob[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([tenantKey, status, createdAt])
  @@index([tenantKey, categoryId, createdAt])
}

model BulkEditOperation {
  id             String                  @id @default(cuid())
  tenantKey      String                  @default("default")
  status         BulkEditOperationStatus @default(processing)
  scope          Json
  updates        Json
  requestedCount Int                     @default(0)
  appliedCount   Int                     @default(0)
  failedCount    Int                     @default(0)
  items          BulkEditOperationItem[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status, updatedAt])
  @@index([tenantKey])
  @@index([tenantKey, status, updatedAt])
}

model BulkEditOperationItem {
  id          String             @id @default(cuid())
  tenantKey   String             @default("default")
  operationId String
  operation   BulkEditOperation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  status      BulkEditItemStatus
  before      Json
  after       Json?
  errorMessage String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([operationId, status])
  @@index([productId])
  @@index([tenantKey])
}

model AccountConsentEvent {
  id               String   @id
  tenantKey        String   @default("default") @map("tenant_key")
  userId           String   @map("user_id")
  accepted         Boolean
  policyVersion    String   @default("dpdp-v1") @map("policy_version")
  purpose          String   @default("account_access")
  consentRecordedAt DateTime @default(now()) @map("consent_recorded_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([tenantKey, userId, createdAt(sort: Desc)], map: "idx_account_consent_events_tenant_user_created")
  @@map("account_consent_events")
}

model AccountExportRequest {
  id                     String   @id
  tenantKey              String   @default("default") @map("tenant_key")
  userId                 String   @map("user_id")
  actorRole              String   @map("actor_role")
  format                 String
  status                 String   @default("queued")
  requestedAt            DateTime @default(now()) @map("requested_at")
  estimatedReadyInSeconds Int     @default(120) @map("estimated_ready_in_seconds")
  artifactPath           String?  @map("artifact_path")
  artifactFileName       String?  @map("artifact_file_name")
  completedAt            DateTime? @map("completed_at")
  failedAt               DateTime? @map("failed_at")
  errorMessage           String?  @map("error_message")
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([tenantKey, userId, requestedAt(sort: Desc)], map: "idx_account_export_requests_tenant_user_requested")
  @@map("account_export_requests")
}

model AuthRecoveryToken {
  id         String   @id
  tenantKey  String   @default("default")
  userId     String
  purpose    String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantKey, userId, purpose, createdAt(sort: Desc)], map: "idx_auth_recovery_token_lookup")
}

model AccountDeletionRequest {
  id          String   @id
  tenantKey   String   @default("default") @map("tenant_key")
  userId      String   @map("user_id")
  actorRole   String   @map("actor_role")
  reason      String?
  status      String   @default("scheduled")
  requestedAt DateTime @default(now()) @map("requested_at")
  scheduledFor DateTime @map("scheduled_for")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantKey, userId, requestedAt(sort: Desc)], map: "idx_account_deletion_requests_tenant_user_requested")
  @@map("account_deletion_requests")
}

model PublicSignupRequest {
  id                   String    @id
  displayName          String
  workspaceSlug        String    @unique
  adminEmail           String    @unique
  passwordHash         String
  verificationTokenHash String   @unique
  status               String    @default("pending")
  acceptedTerms        Boolean   @default(false)
  expiresAt            DateTime
  verifiedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status, expiresAt])
}

model AuditLog {
  id        String   @id
  tenantKey String   @default("default") @map("tenant_key")
  actorId   String   @map("actor_id")
  actorRole String   @map("actor_role")
  action    String
  resource  String
  resourceId String? @map("resource_id")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@index([actorId, createdAt], map: "idx_audit_logs_actor_created_at")
  @@index([resource, createdAt], map: "idx_audit_logs_resource_created_at")
  @@index([tenantKey], map: "idx_audit_logs_tenant_key")
  @@index([tenantKey, resourceId, action, createdAt(sort: Desc)], map: "idx_audit_logs_tenant_resource_action_created")
  @@map("audit_logs")
}

model DashboardSnapshot {
  id                      String   @id
  tenantKey               String   @default("default") @map("tenant_key")
  capturedAt              DateTime @default(now()) @map("captured_at")
  totalSkus               Int      @map("total_skus")
  completeSkus            Int      @map("complete_skus")
  incompleteSkus          Int      @map("incomplete_skus")
  publishReadyByConnector Json     @default("{}") @map("publish_ready_by_connector")
  blockedByConnector      Json     @default("{}") @map("blocked_by_connector")
  rejectionRiskHigh       Int      @default(0) @map("rejection_risk_high")
  openIssuesBlocking      Int      @default(0) @map("open_issues_blocking")
  openIssuesWarning       Int      @default(0) @map("open_issues_warning")

  @@index([tenantKey, capturedAt(sort: Desc)], map: "idx_dashboard_snapshots_tenant_captured_at")
  @@map("dashboard_snapshots")
}

model KpiMetricEvent {
  id            String   @id
  tenantKey     String   @default("default") @map("tenant_key")
  connectorSlug String?  @map("connector_slug")
  metricKey     String   @map("metric_key")
  metricValue   Float    @map("metric_value")
  unit          String?
  tags          Json     @default("{}")
  observedAt    DateTime @default(now()) @map("observed_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantKey, metricKey, observedAt(sort: Desc)], map: "idx_kpi_metric_events_tenant_metric_time")
  @@index([tenantKey, connectorSlug, observedAt(sort: Desc)], map: "idx_kpi_metric_events_tenant_connector_time")
  @@map("kpi_metric_events")
}

model PlanLimits {
  id                     String   @id @default(cuid())
  planTier               String   @unique
  maxSkus                Int
  maxSubmissionsPerMonth Int
  maxUsers               Int
  maxStorageGb           Float
  maxConnectorInstallations Int   @default(2)
  maxAccountsPerConnector Int     @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model PlanUsage {
  id              String   @id @default(cuid())
  tenantKey       String   @default("default")
  month           String
  planTier        String   @default("STARTER")
  skuCount        Int      @default(0)
  submissionCount Int      @default(0)
  storageGb       Float    @default(0)
  connectorInstallationsCount Int @default(0)
  connectorAccountsCount      Int @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([tenantKey, month])
  @@index([tenantKey, month])
}

model TenantPlanProfile {
  id                     String   @id @default(cuid())
  tenantKey              String   @unique
  planTier               String   @default("STARTER")
  billingStatus          String   @default("trial")
  accessStatus           String   @default("active")
  effectiveFrom          DateTime?
  trialEndsAt            DateTime?
  paidThroughAt          DateTime?
  graceEndsAt            DateTime?
  cancelledAt            DateTime?
  suspendedAt            DateTime?
  suspensionReason       String?
  billingContactEmail    String?
  billingProvider        String?
  externalCustomerId     String?
  externalSubscriptionId String?
  updatedBy              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([tenantKey, planTier])
  @@index([tenantKey, billingStatus, accessStatus])
}

model TenantAuthPolicy {
  id                    String   @id @default(cuid())
  tenantKey             String   @unique
  externalIdentityMode  Boolean  @default(false)
  mfaRequired           Boolean  @default(false)
  mfaGracePeriodDays    Int      @default(7)
  sessionTimeoutMinutes Int      @default(240)
  allowedAuthMethods    String[] @default(["password"])
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tenantKey, updatedAt])
}

model UserMfaEnrollment {
  id               String    @id @default(cuid())
  tenantKey        String    @default("default")
  userId           String
  method           String    @default("totp")
  status           String    @default("pending")
  secretEncrypted  String    @map("secret_encrypted")
  secretKeyVersion String    @default("v1") @map("secret_key_version")
  secretPreview    String?   @map("secret_preview")
  enrolledAt       DateTime? @map("enrolled_at")
  verifiedAt       DateTime? @map("verified_at")
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  backupCodes      UserMfaBackupCode[]

  @@unique([tenantKey, userId, method], map: "user_mfa_enrollment_tenant_user_method_unique")
  @@index([tenantKey, userId, status], map: "idx_user_mfa_enrollment_tenant_user_status")
  @@map("user_mfa_enrollments")
}

model UserMfaBackupCode {
  id           String            @id @default(cuid())
  tenantKey    String            @default("default")
  userId       String
  enrollmentId String            @map("enrollment_id")
  enrollment   UserMfaEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  codeHash     String            @map("code_hash")
  consumedAt   DateTime?         @map("consumed_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([tenantKey, userId, enrollmentId], map: "idx_user_mfa_backup_code_lookup")
