generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  draft
  in_review
  approved
  rejected
  active
  archived
}

enum AttributeDataType {
  text
  number
  boolean
  select
  json
}

enum AppliesTo {
  product
  variant
}

enum RuleSeverity {
  error
  warning
}

enum RuleType {
  required_field
  regex_field
  value_in_set
}

enum ValidationIssueStatus {
  open
  resolved
}

enum ExportJobStatus {
  queued
  processing
  retrying
  skipped
  completed
  failed
  dead_letter
}

enum BulkImportJobStatus {
  queued
  processing
  retrying
  completed
  failed
  dead_letter
}

enum BulkImportRowStatus {
  queued
  processing
  success
  retrying
  failed
  dead_letter
}

enum BulkEditOperationStatus {
  processing
  completed
  failed
}

enum BulkEditItemStatus {
  success
  failed
}

enum ConnectorPermissionPrincipalType {
  user
  role
}

enum ConnectorPermissionAction {
  install
  reconnect
  uninstall
}

model Category {
  id                   String                @id @default(cuid())
  tenantKey            String                @default("default")
  name                 String
  slug                 String
  path                 String
  parentId             String?
  parent               Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children             Category[]            @relation("CategoryHierarchy")
  products             Product[]
  attributeDefinitions AttributeDefinition[]
  complianceRules      ComplianceRule[]
  mappingTemplates     ChannelMappingTemplate[]
  exportJobs           MarketplaceExportJob[]
  bulkImportJobs       BulkImportJob[]
  bulkImportTemplates  BulkImportTemplate[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([parentId])
  @@index([path])
  @@index([tenantKey])
  @@unique([tenantKey, slug])
}

model BulkImportTemplate {
  id          String   @id @default(cuid())
  tenantKey   String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  version     Int      @default(1)
  sourceFormat String
  mapping     Json
  schemaSnapshot Json?
  chunkSize   Int      @default(100)
  maxRetries  Int      @default(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantKey, categoryId, name, version])
  @@index([tenantKey, categoryId, name, version])
  @@index([tenantKey, categoryId, updatedAt])
}

model Product {
  id               String            @id @default(cuid())
  tenantKey        String            @default("default")
  title            String
  description      String            @default("")
  brand            String            @default("")
  status           RecordStatus      @default(draft)
  version          Int               @default(1)
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  hsnCode          String?
  gstRate          Float?
  attributes       Json              @default("{}")
  variants         Variant[]
  mediaAssets      MediaAsset[]
  validationIssues ValidationIssue[] @relation("ProductValidationIssues")
  exportJobs       MarketplaceExportJob[]
  importedRows     BulkImportRow[]
  bulkEditItems    BulkEditOperationItem[]
  deletedAt        DateTime?
  purgedById       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([hsnCode])
  @@index([tenantKey])
  @@index([tenantKey, status])
  @@index([tenantKey, deletedAt])
  @@index([tenantKey, deletedAt, updatedAt(sort: Desc), id(sort: Desc)], map: "idx_product_tenant_deleted_updated_id")
}

model Variant {
  id               String            @id @default(cuid())
  tenantKey        String            @default("default")
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuCode          String
  mediaAssets      MediaAsset[]
  attributes       Json              @default("{}")
  mrp              Float?
  sellingPrice     Float?
  inventoryQty     Int               @default(0)
  status           RecordStatus      @default(draft)
  validationIssues ValidationIssue[] @relation("VariantValidationIssues")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([productId])
  @@index([status])
  @@index([tenantKey])
  @@unique([tenantKey, skuCode])
}

model MediaAsset {
  id         String   @id
  tenantKey  String   @default("default") @map("tenant_key")
  productId  String?  @map("product_id")
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId  String?  @map("variant_id")
  variant    Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  entityType String   @default("product") @map("entity_type")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  storagePath String  @map("storage_path")
  width      Int?
  height     Int?
  sizeBytes  Int      @map("size_bytes")
  checksum   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@index([tenantKey], map: "idx_media_assets_tenant_key")
  @@index([tenantKey, createdAt(sort: Desc)], map: "idx_media_assets_tenant_created_at")
  @@index([productId, createdAt(sort: Desc)], map: "idx_media_assets_product_created_at")
  @@index([variantId, createdAt(sort: Desc)], map: "idx_media_assets_variant_created_at")
  @@map("media_assets")
}

model AttributeDefinition {
  id            String            @id @default(cuid())
  tenantKey     String            @default("default")
  categoryId    String
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key           String
  name          String
  dataType      AttributeDataType
  required      Boolean           @default(false)
  allowedValues Json?
  appliesTo     AppliesTo         @default(product)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([categoryId, key, appliesTo])
  @@index([categoryId])
  @@index([appliesTo])
  @@index([tenantKey])
}

model ComplianceRule {
  id        String           @id @default(cuid())
  tenantKey String           @default("default")
  ruleCode  String           @unique
  name      String
  categoryId String?
  category  Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  severity  RuleSeverity     @default(error)
  ruleType  RuleType
  config    Json
  active    Boolean          @default(true)
  issues    ValidationIssue[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([categoryId, active])
  @@index([ruleType])
  @@index([tenantKey])
}

model ValidationIssue {
  id        String                @id @default(cuid())
  tenantKey String                @default("default")
  productId String
  product   Product               @relation("ProductValidationIssues", fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   Variant?              @relation("VariantValidationIssues", fields: [variantId], references: [id], onDelete: Cascade)
  ruleId    String?
  rule      ComplianceRule?       @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  severity  RuleSeverity
  ruleCode  String
  message   String
  fieldPath String?
  status    ValidationIssueStatus @default(open)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([productId])
  @@index([variantId])
  @@index([status])
  @@index([ruleCode])
  @@index([tenantKey])
}

model ChannelMappingTemplate {
  id             String               @id @default(cuid())
  tenantKey      String               @default("default")
  name           String
  isSystemPack   Boolean              @default(false)
  createdBy      String?
  version        Int                  @default(1)
  parentTemplateId String?
  categoryId     String
  category       Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  channel        String               @db.VarChar(64)
  requiredFields Json
  fieldMap       Json
  isDefault      Boolean              @default(false)
  jobs           MarketplaceExportJob[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([categoryId, channel, name])
  @@index([categoryId, channel])
  @@index([tenantKey, channel, version])
  @@index([parentTemplateId])
  @@index([tenantKey])
}

model MarketplaceExportJob {
  id           String                 @id @default(cuid())
  tenantKey    String                 @default("default")
  createdBy    String?                @map("created_by")
  productId    String
  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  channel      String                 @db.VarChar(64)
  templateId   String?
  template     ChannelMappingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status       ExportJobStatus        @default(queued)
  retryCount   Int                    @default(0)
  maxRetries   Int                    @default(3)
  failureReason String?
  dlqReason    String?
  payload      Json?
  exportPayload Json?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([productId, channel])
  @@index([status, updatedAt])
  @@index([templateId])
  @@index([tenantKey])
  @@index([tenantKey, createdBy, updatedAt])
}

model BulkImportJob {
  id             String              @id @default(cuid())
  tenantKey      String              @default("default")
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sourceFormat   String
  sourceName     String?
  mapping        Json
  chunkSize      Int                 @default(100)
  maxRetries     Int                 @default(3)
  status         BulkImportJobStatus @default(queued)
  totalRows      Int                 @default(0)
  processedRows  Int                 @default(0)
  successRows    Int                 @default(0)
  failedRows     Int                 @default(0)
  deadLetterRows Int                 @default(0)
  rows           BulkImportRow[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([categoryId])
  @@index([status, updatedAt])
  @@index([tenantKey])
}

model BulkImportRow {
  id            String              @id @default(cuid())
  tenantKey     String              @default("default")
  jobId         String
  job           BulkImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber     Int
  payload       Json
  status        BulkImportRowStatus @default(queued)
  retryCount    Int                 @default(0)
  errorMessage  String?
  productId     String?
  product       Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  lastAttemptAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([jobId, rowNumber])
  @@index([jobId, status, rowNumber])
  @@index([productId])
  @@index([tenantKey])
}

model BulkEditOperation {
  id             String                  @id @default(cuid())
  tenantKey      String                  @default("default")
  status         BulkEditOperationStatus @default(processing)
  scope          Json
  updates        Json
  requestedCount Int                     @default(0)
  appliedCount   Int                     @default(0)
  failedCount    Int                     @default(0)
  items          BulkEditOperationItem[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status, updatedAt])
  @@index([tenantKey])
}

model BulkEditOperationItem {
  id          String             @id @default(cuid())
  tenantKey   String             @default("default")
  operationId String
  operation   BulkEditOperation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  status      BulkEditItemStatus
  before      Json
  after       Json?
  errorMessage String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([operationId, status])
  @@index([productId])
  @@index([tenantKey])
}

model AccountConsentEvent {
  id               String   @id
  tenantKey        String   @default("default") @map("tenant_key")
  userId           String   @map("user_id")
  accepted         Boolean
  policyVersion    String   @default("dpdp-v1") @map("policy_version")
  purpose          String   @default("account_access")
  consentRecordedAt DateTime @default(now()) @map("consent_recorded_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([tenantKey, userId, createdAt(sort: Desc)], map: "idx_account_consent_events_tenant_user_created")
  @@map("account_consent_events")
}

model AccountExportRequest {
  id                     String   @id
  tenantKey              String   @default("default") @map("tenant_key")
  userId                 String   @map("user_id")
  actorRole              String   @map("actor_role")
  format                 String
  status                 String   @default("queued")
  requestedAt            DateTime @default(now()) @map("requested_at")
  estimatedReadyInSeconds Int     @default(120) @map("estimated_ready_in_seconds")
  artifactPath           String?  @map("artifact_path")
  artifactFileName       String?  @map("artifact_file_name")
  completedAt            DateTime? @map("completed_at")
  failedAt               DateTime? @map("failed_at")
  errorMessage           String?  @map("error_message")
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([tenantKey, userId, requestedAt(sort: Desc)], map: "idx_account_export_requests_tenant_user_requested")
  @@map("account_export_requests")
}

model AuthRecoveryToken {
  id         String   @id
  tenantKey  String   @default("default")
  userId     String
  purpose    String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantKey, userId, purpose, createdAt(sort: Desc)], map: "idx_auth_recovery_token_lookup")
}

model AccountDeletionRequest {
  id          String   @id
  tenantKey   String   @default("default") @map("tenant_key")
  userId      String   @map("user_id")
  actorRole   String   @map("actor_role")
  reason      String?
  status      String   @default("scheduled")
  requestedAt DateTime @default(now()) @map("requested_at")
  scheduledFor DateTime @map("scheduled_for")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantKey, userId, requestedAt(sort: Desc)], map: "idx_account_deletion_requests_tenant_user_requested")
  @@map("account_deletion_requests")
}

model PublicSignupRequest {
  id                   String    @id
  displayName          String
  workspaceSlug        String    @unique
  adminEmail           String    @unique
  passwordHash         String
  verificationTokenHash String   @unique
  status               String    @default("pending")
  acceptedTerms        Boolean   @default(false)
  expiresAt            DateTime
  verifiedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status, expiresAt])
}

model AuditLog {
  id        String   @id
  tenantKey String   @default("default") @map("tenant_key")
  actorId   String   @map("actor_id")
  actorRole String   @map("actor_role")
  action    String
  resource  String
  resourceId String? @map("resource_id")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@index([actorId, createdAt], map: "idx_audit_logs_actor_created_at")
  @@index([resource, createdAt], map: "idx_audit_logs_resource_created_at")
  @@index([tenantKey], map: "idx_audit_logs_tenant_key")
  @@map("audit_logs")
}

model DashboardSnapshot {
  id                      String   @id
  tenantKey               String   @default("default") @map("tenant_key")
  capturedAt              DateTime @default(now()) @map("captured_at")
  totalSkus               Int      @map("total_skus")
  completeSkus            Int      @map("complete_skus")
  incompleteSkus          Int      @map("incomplete_skus")
  publishReadyByConnector Json     @default("{}") @map("publish_ready_by_connector")
  blockedByConnector      Json     @default("{}") @map("blocked_by_connector")
  rejectionRiskHigh       Int      @default(0) @map("rejection_risk_high")
  openIssuesBlocking      Int      @default(0) @map("open_issues_blocking")
  openIssuesWarning       Int      @default(0) @map("open_issues_warning")

  @@index([tenantKey, capturedAt(sort: Desc)], map: "idx_dashboard_snapshots_tenant_captured_at")
  @@map("dashboard_snapshots")
}

model KpiMetricEvent {
  id            String   @id
  tenantKey     String   @default("default") @map("tenant_key")
  connectorSlug String?  @map("connector_slug")
  metricKey     String   @map("metric_key")
  metricValue   Float    @map("metric_value")
  unit          String?
  tags          Json     @default("{}")
  observedAt    DateTime @default(now()) @map("observed_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantKey, metricKey, observedAt(sort: Desc)], map: "idx_kpi_metric_events_tenant_metric_time")
  @@index([tenantKey, connectorSlug, observedAt(sort: Desc)], map: "idx_kpi_metric_events_tenant_connector_time")
  @@map("kpi_metric_events")
}

model PlanLimits {
  id                     String   @id @default(cuid())
  planTier               String   @unique
  maxSkus                Int
  maxSubmissionsPerMonth Int
  maxUsers               Int
  maxStorageGb           Float
  maxConnectorInstallations Int   @default(2)
  maxAccountsPerConnector Int     @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model PlanUsage {
  id              String   @id @default(cuid())
  tenantKey       String   @default("default")
  month           String
  planTier        String   @default("STARTER")
  skuCount        Int      @default(0)
  submissionCount Int      @default(0)
  storageGb       Float    @default(0)
  connectorInstallationsCount Int @default(0)
  connectorAccountsCount      Int @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([tenantKey, month])
  @@index([tenantKey, month])
}

model TenantPlanProfile {
  id                     String   @id @default(cuid())
  tenantKey              String   @unique
  planTier               String   @default("STARTER")
  billingStatus          String   @default("trial")
  accessStatus           String   @default("active")
  effectiveFrom          DateTime?
  trialEndsAt            DateTime?
  paidThroughAt          DateTime?
  graceEndsAt            DateTime?
  cancelledAt            DateTime?
  suspendedAt            DateTime?
  suspensionReason       String?
  billingContactEmail    String?
  billingProvider        String?
  externalCustomerId     String?
  externalSubscriptionId String?
  updatedBy              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([tenantKey, planTier])
  @@index([tenantKey, billingStatus, accessStatus])
}

model TenantCommercialRequest {
  id                   String   @id @default(cuid())
  tenantKey            String   @default("default")
  requestType          String   @default("upgrade")
  status               String   @default("open")
  requestedBy          String   @map("requested_by")
  requesterRole        String   @map("requester_role")
  currentPlanTier      String   @map("current_plan_tier")
  currentBillingStatus String   @map("current_billing_status")
  currentAccessStatus  String   @map("current_access_status")
  notes                String?
  source               String   @default("admin_plan")
  resolvedAt           DateTime? @map("resolved_at")
  resolvedBy           String?   @map("resolved_by")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([tenantKey, status, createdAt(sort: Desc)], map: "idx_tenant_commercial_requests_tenant_status_created")
  @@index([tenantKey, requestType, createdAt(sort: Desc)], map: "idx_tenant_commercial_requests_tenant_type_created")
  @@index([requestedBy, createdAt(sort: Desc)], map: "idx_tenant_commercial_requests_requester_created")
  @@map("tenant_commercial_requests")
}

model ConnectorDefinition {
  id               String   @id
  slug             String   @unique
  displayName      String   @map("display_name")
  authType         String   @map("auth_type")
  capabilities     String[]
  marketplaceId    String?  @map("marketplace_id")
  connectorVersion String   @default("1.0.0") @map("connector_version")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @map("updated_at")

  @@map("connector_definitions")
}

model ConnectorInstallation {
  id                 String    @id
  tenantKey          String    @default("default") @map("tenant_key")
  connectorId        String    @map("connector_id")
  accountAlias       String    @default("primary") @map("account_alias")
  externalAccountRef String?   @map("external_account_ref")
  status             String    @default("ACTIVE")
  metadata           Json      @default("{}")
  installedAt        DateTime  @default(now()) @map("installed_at")
  installedBy        String    @map("installed_by")
  lastSyncAt         DateTime? @map("last_sync_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @map("updated_at")

  @@unique([tenantKey, connectorId, accountAlias], map: "connector_installations_tenant_connector_alias_unique")
  @@index([tenantKey, installedAt(sort: Desc), id(sort: Desc)], map: "idx_connector_installations_tenant_installed_at")
  @@map("connector_installations")
}

model ConnectorCredential {
  id              String    @id
  tenantKey       String    @default("default") @map("tenant_key")
  installationId  String    @map("installation_id")
  credentialType  String    @map("credential_type")
  encryptedValue  String    @map("encrypted_value")
  keyVersion      String    @default("v1") @map("key_version")
  status          String    @default("ACTIVE")
  scope           String?
  expiresAt       DateTime? @map("expires_at")
  lastValidatedAt DateTime? @map("last_validated_at")
  lastRefreshAt   DateTime? @map("last_refresh_at")
  failureReason   String?   @map("failure_reason")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")

  @@unique([installationId, credentialType], map: "connector_credentials_installation_type_unique")
  @@map("connector_credentials")
}

model ConnectorSubmission {
  id                 String    @id
  tenantKey          String    @default("default") @map("tenant_key")
  installationId     String    @map("installation_id")
  productId          String    @map("product_id")
  variantId          String?   @map("variant_id")
  idempotencyKey     String    @map("idempotency_key")
  submissionType     String    @map("submission_type")
  source             String
  attemptNumber      Int       @default(1) @map("attempt_number")
  status             String
  externalRef        String?   @map("external_ref")
  payloadSnapshot    Json      @map("payload_snapshot")
  payloadSnapshotUrl String?   @map("payload_snapshot_url")
  channelErrors      Json?     @map("channel_errors")
  submittedAt        DateTime  @default(now()) @map("submitted_at")
  resolvedAt         DateTime? @map("resolved_at")

  @@unique([tenantKey, installationId, idempotencyKey], map: "idx_connector_submissions_tenant_installation_idempotency")
  @@index([tenantKey, status, submittedAt(sort: Desc)], map: "idx_connector_submissions_tenant_status")
  @@map("connector_submissions")
}

model ConnectorWebhookEvent {
  id              String    @id
  tenantKey       String    @default("default") @map("tenant_key")
  installationId  String    @map("installation_id")
  externalEventId String    @map("external_event_id")
  eventType       String    @map("event_type")
  payload         Json
  receivedAt      DateTime  @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")
  submissionId    String?   @map("submission_id")

  @@unique([installationId, externalEventId], map: "connector_webhook_installation_event_unique")
  @@index([tenantKey, installationId, processedAt], map: "idx_connector_webhooks_tenant_processed")
  @@map("connector_webhook_events")
}

model ConnectorMappingVersion {
  id                         String    @id
  tenantKey                  String    @default("default") @map("tenant_key")
  connectorSlug              String    @map("connector_slug")
  categoryScope              String    @map("category_scope")
  mappingLevel               String    @map("mapping_level")
  lifecycleState             String    @map("lifecycle_state")
  connectorDefinitionId      String    @map("connector_definition_id")
  connectorDefinitionVersion String    @map("connector_definition_version")
  compatibilityState         String    @default("compatible") @map("compatibility_state")
  mappingRules               Json      @default("{}") @map("mapping_rules")
  fallbackPolicy             Json      @default("{}") @map("fallback_policy")
  fallbackAckRequired        Boolean   @default(false) @map("fallback_ack_required")
  publishedAt                DateTime? @map("published_at")
  supersededBy               String?   @map("superseded_by")
  createdBy                  String?   @map("created_by")
  archivedAt                 DateTime? @map("archived_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@index([tenantKey, connectorSlug, categoryScope, lifecycleState, createdAt(sort: Desc)], map: "idx_connector_mapping_versions_lookup")
  @@index([tenantKey, connectorSlug, compatibilityState, lifecycleState, createdAt(sort: Desc)], map: "idx_connector_mapping_versions_compat")
  @@map("connector_mapping_versions")
}

model ConnectorMappingEvent {
  id               String   @id
  tenantKey        String   @default("default") @map("tenant_key")
  mappingVersionId String   @map("mapping_version_id")
  eventType        String   @map("event_type")
  actorId          String?  @map("actor_id")
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([tenantKey, mappingVersionId, createdAt(sort: Desc)], map: "idx_connector_mapping_events_lookup")
  @@map("connector_mapping_events")
}

model ConnectorPermission {
  id            String                            @id @default(cuid())
  tenantKey     String                            @default("default")
  principalType ConnectorPermissionPrincipalType
  principalId   String
  connectorSlug String
  accountAlias  String                            @default("*")
  action        ConnectorPermissionAction
  createdBy     String?
  createdAt     DateTime                          @default(now())
  updatedAt     DateTime                          @updatedAt

  @@unique([tenantKey, principalType, principalId, connectorSlug, accountAlias, action])
  @@index([tenantKey, principalType, principalId])
  @@index([tenantKey, connectorSlug, action])
}

model AuthIdentity {
  id        String   @id @default(cuid())
  tenantKey String   @default("default")
  userId    String   @unique
  role      String   @default("viewer")
  isActive  Boolean  @default(true)
  lockedUntil DateTime?
  passwordHash String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantKey, role, isActive])
  @@index([tenantKey, createdAt(sort: Desc), id(sort: Desc)], map: "idx_auth_identity_tenant_created_id")
}

model ApiAccessKey {
  id         String    @id
  tenantKey  String    @default("default")
  label      String
  role       String    @default("viewer")
  keyPrefix  String    @map("key_prefix")
  secretHash String    @map("secret_hash")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([tenantKey, createdAt(sort: Desc), id(sort: Desc)], map: "idx_api_access_keys_tenant_created_id")
  @@index([tenantKey, revokedAt, expiresAt], map: "idx_api_access_keys_tenant_revoked_expires")
  @@map("api_access_keys")
}

model WorkspaceDirectory {
  id            String   @id @default(cuid())
  tenantKey     String   @unique
  workspaceSlug String   @unique
  displayName   String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserNotification {
  id         String   @id
  tenantKey  String   @default("default") @map("tenant_key")
  userId     String   @map("user_id")
  eventType  String   @map("event_type")
  title      String
  message    String
  actionUrl  String?  @map("action_url")
  actionLabel String? @map("action_label")
  metadata   Json     @default("{}")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantKey, userId, createdAt(sort: Desc)], map: "idx_user_notifications_tenant_user_created")
  @@index([tenantKey, userId, readAt, createdAt(sort: Desc)], map: "idx_user_notifications_tenant_user_read_created")
  @@map("user_notifications")
}

model OutboundWebhookEndpoint {
  id                      String    @id @default(cuid())
  tenantKey               String    @default("default") @map("tenant_key")
  name                    String
  eventType               String    @map("event_type")
  targetUrl               String    @map("target_url")
  signingSecretEncrypted  String    @map("signing_secret_encrypted")
  signingSecretKeyVersion String    @map("signing_secret_key_version")
  isActive                Boolean   @default(true) @map("is_active")
  createdBy               String?   @map("created_by")
  lastTriggeredAt         DateTime? @map("last_triggered_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@index([tenantKey, eventType, isActive], map: "idx_outbound_webhook_endpoints_tenant_event_active")
  @@index([tenantKey, createdAt(sort: Desc)], map: "idx_outbound_webhook_endpoints_tenant_created")
  @@map("outbound_webhook_endpoints")
}

model OutboundWebhookDelivery {
  id             String    @id @default(cuid())
  tenantKey      String    @default("default") @map("tenant_key")
  endpointId     String    @map("endpoint_id")
  eventType      String    @map("event_type")
  eventId        String    @map("event_id")
  status         String    @default("queued")
  attemptCount   Int       @default(0) @map("attempt_count")
  requestBody    Json      @default("{}") @map("request_body")
  responseStatus Int?      @map("response_status")
  responseBody   String?   @map("response_body")
  errorMessage   String?   @map("error_message")
  attemptedAt    DateTime? @map("attempted_at")
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([tenantKey, endpointId, createdAt(sort: Desc)], map: "idx_outbound_webhook_deliveries_endpoint_created")
  @@index([tenantKey, eventType, status, createdAt(sort: Desc)], map: "idx_outbound_webhook_deliveries_event_status_created")
  @@map("outbound_webhook_deliveries")
}
