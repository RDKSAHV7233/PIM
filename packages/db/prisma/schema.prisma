  providerKey                   String                 @default("default") @map("provider_key")
  executionMode                 String                 @default("live_provider") @map("execution_mode")
  periodKey                     String                 @map("period_key")
  requestFingerprint            String                 @map("request_fingerprint")
  requestedEstimatedCostMicros  Int                    @map("requested_estimated_cost_micros")
  reservedCostMicros            Int                    @default(0) @map("reserved_cost_micros")
  actualCostMicros              Int?                   @map("actual_cost_micros")
  currency                      String                 @default("USD")
  status                        String                 @default("reserved")
  correlationId                 String?                @map("correlation_id")
  executionId                   String?                @map("execution_id")
  createdAt                     DateTime               @default(now()) @map("created_at")
  updatedAt                     DateTime               @updatedAt @map("updated_at")

  @@unique([tenantKey, requestFingerprint], map: "ai_provider_budget_reservations_tenant_fingerprint_unique")
  @@index([tenantKey, budgetPolicyId, status], map: "idx_ai_provider_budget_reservations_policy_status")
  @@index([tenantKey, capability, providerKey, executionMode, periodKey], map: "idx_ai_provider_budget_reservations_scope")
  @@map("ai_provider_budget_reservations")
}
