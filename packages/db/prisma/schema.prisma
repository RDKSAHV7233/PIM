// ── RG-C4: Product relationships / bundles / kits ─────────────────────────

enum ProductRelationshipType {
  bundle_component  // this product is a component of a bundle
  bundle_parent     // this product is the bundle containing components
  kit_component     // this product is a component of a kit
  kit_parent        // this product is the kit containing components
  accessory         // this product is an accessory for the related product
  replacement       // this product is a replacement/substitute
  similar           // this product is similar/related
}

model ProductRelationship {
  id              String                  @id @default(cuid())
  tenantKey       String                  @default("default") @map("tenant_key")
  sourceProductId String                  @map("source_product_id")
  sourceProduct   Product                 @relation("RelationshipSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProductId String                  @map("target_product_id")
  targetProduct   Product                 @relation("RelationshipTarget", fields: [targetProductId], references: [id], onDelete: Cascade)
  type            ProductRelationshipType
  quantityInParent Int?                   @map("quantity_in_parent")
  sortOrder       Int                     @default(0) @map("sort_order")
  metadata        Json                    @default("{}")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@unique([tenantKey, sourceProductId, targetProductId, type], map: "uq_product_relationship_source_target_type")
  @@index([tenantKey, sourceProductId], map: "idx_product_relationships_source")
  @@index([tenantKey, targetProductId], map: "idx_product_relationships_target")
  @@index([tenantKey, type], map: "idx_product_relationships_type")
  @@map("product_relationships")
}

// ── Tax Attributes ─────────────────────────────────────────────────────────────

/// Canonical tax identifier key types across all supported regimes.
/// Enum values map directly to Prisma-generated TaxCodeKey.
enum TaxCodeKey {
  HSN_CODE        // India GST — 4/6/8 digit Harmonized System of Nomenclature
  HS_CODE         // International / UAE VAT — 6-digit Harmonized System code
  COMMODITY_CODE  // UK Trade Tariff — 10-digit commodity code
  TAX_CATEGORY    // US Sales Tax — Avalara/AvaTax category string
}

/// System-level tax regime registry — not per-tenant, seeded at deploy time.
/// One row per market (IN = India GST, GB = UK VAT, US = US Sales Tax, etc.).
model TaxRegime {
  id          String           @id @default(cuid())
  marketCode  String           @unique  // ISO country code: "IN" | "GB" | "US" | "AE" | "AU"
  name        String           // "India GST", "UK VAT", "US Sales Tax"
  description String           @default("")
  taxCodes    ProductTaxCode[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("tax_regimes")
}

/// Per-product tax identifiers — one row per (tenantKey, product, marketCode, key) triple.
/// Additive alongside legacy Product.hsnCode / Product.gstRate (India flat fields stay).
model ProductTaxCode {
  id         String      @id @default(cuid())
  tenantKey  String      @default("default")
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  regimeId   String
  regime     TaxRegime   @relation(fields: [regimeId], references: [id], onDelete: Restrict)
  marketCode String      // denormalized from regime — avoids join on common read/delete paths
  key        TaxCodeKey  // enum — prevents free-form drift
  value      String      // e.g. "62044200", "6204420000", "CLOTHING"
  rate       Float?      // Tax rate %: 5/12/18/28 (GST), 20 (UK VAT), null if not applicable
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([tenantKey, productId, marketCode, key])
  @@index([tenantKey])
  @@index([productId])
  @@index([tenantKey, productId])   // fast delete path: deleteMany({ where: { tenantKey, productId } })
  @@index([tenantKey, marketCode])
  @@map("product_tax_codes")
}

