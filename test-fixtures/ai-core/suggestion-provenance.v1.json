    "tenantKeyMustMatchActorTenantKey": true,
    "crossTenantReviewState": "blocked_unauthorized"
  },
  "rbacBoundary": {
    "requiredRole": "AI_SUGGESTION_REVIEWER",
    "requiredScope": "ai:suggestion:review"
  },
  "forbiddenRuntimeEffects": [
    "directProductPatch",
    "canonicalProductPatch",
    "productUpdate",
    "productServiceMutation",
    "providerCall",
    "schemaMigration"
  ],
  "negativeCases": [
    "missing_factual_evidence",
    "tampered_generated_payload",
    "stale_source_version",
    "reviewer_edit_overwrites_suggested_value",
    "accepted_with_changed_reviewed_value",
    "edited_without_distinct_reviewed_value",
    "rejected_with_applied_value",
    "wrong_tenant_review",
    "unauthorized_reviewer",
    "direct_product_patch_present",
    "duplicate_generation_without_same_idempotency_key",
    "apply_without_product_service_transaction",
    "terminal_state_without_audit_linkage"
  ],
