+function mockResolveMappings(connectorSlug: string, categoryScope: string) {
+  const published = MOCK_MAPPINGS.filter(
+    (row) =>
+      row.connector_slug === connectorSlug &&
+      row.lifecycle_state === "published" &&
+      (row.category_scope === "*" || row.category_scope === categoryScope)
+  ).sort((a, b) => {
+    const rank = (value: MockMappingVersion["mapping_level"]) =>
+      value === "tenant_connector_default" ? 1 : 2;
+    return rank(a.mapping_level) - rank(b.mapping_level);
+  });
+  const merged: Record<string, unknown> = {};
+  for (const row of published) {
+    const rules = row.mapping_rules ?? {};
+    if (rules && typeof rules === "object" && !Array.isArray(rules)) {
+      Object.assign(merged, rules);
+    }
+  }
+  const fieldMappings =
+    merged.field_mappings && typeof merged.field_mappings === "object" && !Array.isArray(merged.field_mappings)
+      ? (merged.field_mappings as Record<string, unknown>)
+      : {};
+  const overrides =
+    merged.attribute_overrides && typeof merged.attribute_overrides === "object" && !Array.isArray(merged.attribute_overrides)
+      ? (merged.attribute_overrides as Record<string, unknown>)
+      : {};
+  return {
+    published,
+    resolved: {
+      ...merged,
+      field_mappings: { ...fieldMappings, ...overrides },
+    },
+  };
