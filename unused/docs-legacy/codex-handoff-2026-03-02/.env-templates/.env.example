# .env.example — PIM1 Connector-First Architecture
# Copy to .env for local development. Never commit .env with real values.
# All keys must be present. Missing keys will cause startup failure.

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/pim1_dev

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=                          # min 32 chars, generate: openssl rand -base64 32
JWT_EXPIRY=24h

# ── Credential Encryption ────────────────────────────────────────────
CREDENTIAL_ENCRYPTION_KEY=           # AES-256 key, generate: openssl rand -base64 32
# IMPORTANT: Document key rotation runbook BEFORE storing any production credentials
# Store key version in ConnectorCredential.keyVersion for rotation support

# ── Cloud Media Storage (Cloudflare R2 or AWS S3) ───────────────────
R2_ACCOUNT_ID=                       # Cloudflare account ID
R2_ACCESS_KEY_ID=                    # R2 API token (S3-compatible)
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pim1-media-dev
R2_PUBLIC_URL=                       # https://your-cdn-domain.com — permanent public base URL
# For AWS S3: replace R2_* with standard AWS_* vars and set AWS_REGION=ap-south-1

# ── Amazon SP-API ────────────────────────────────────────────────────
# Obtain from: developer.amazon.in → Developer Console → Your App
# R&D required: RD-AMAZON-1 (3-7 day approval)
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV  # Amazon India — do not change
AMAZON_SANDBOX_SELLER_ID=            # For sandbox testing only
AMAZON_SP_API_BASE_URL=https://sellingpartnerapi-eu.amazon.com  # India uses EU endpoint

# ── Flipkart Partner API ─────────────────────────────────────────────
# Obtain from: Flipkart Partner Portal (not seller dashboard)
# R&D required: RD-FLIPKART-1 (3-10 day approval)
FLIPKART_CLIENT_ID=
FLIPKART_CLIENT_SECRET=
FLIPKART_API_BASE_URL=https://api.flipkart.com

# ── Meesho Supplier API ──────────────────────────────────────────────
# Obtain by emailing: meesholink-integration@meesho.com (1-2 week lead time)
# R&D required: RD-MEESHO-1 — SEND EMAIL TODAY
MEESHO_MERCHANT_ID=
MEESHO_SECRET_KEY=
MEESHO_API_BASE_URL=                 # Different for sandbox vs production — see RD_CONNECTORS.md

# ── Feature Flags ───────────────────────────────────────────────────
FEATURE_REAL_SPAPI_VALIDATION=false  # Set true only when Amazon credentials available
FEATURE_WORKFLOW_GATING=false        # Draft → Review → Approve workflow (P6-S3)

# ── Queue (BullMQ / Redis) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Notifications ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@pim1.in

# ── App ─────────────────────────────────────────────────────────────
PORT=4000
APP_BASE_URL=http://localhost:4000   # Used for OAuth callback URLs
NODE_ENV=development
